<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Model\LadyIDE.Model.csproj" />
    <ProjectReference Include="..\Persistence\LadyIDE.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Themes\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RichCanvas" Version="3.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Page Update="Styles\CanvasElementsStyles.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Styles\MenuBarStyles.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Styles\PaletteStyles.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Styles\TabStyles.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

</Project>
