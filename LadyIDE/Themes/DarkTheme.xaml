    <SolidColorBrush x:Key="RecordBorder"
                     Color="#E69A00"/>

    <SolidColorBrush x:Key="RecordHeader"
                     Color="#FFF0C9"/>

    <SolidColorBrush x:Key="RecordBackground"
                     Color="#FFFBEE"/>


    <!-- ================================================= -->
    <!-- ENTITY                                            -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="EntityBorder"
                     Color="#D94DAF"/>

    <SolidColorBrush x:Key="EntityHeader"
                     Color="#FFDDF2"/>

    <SolidColorBrush x:Key="EntityBackground"
                     Color="#FFF2FA"/>


    <!-- ================================================= -->
    <!-- ENUM                                              -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="EnumBorder"
                     Color="#3FA66B"/>

    <SolidColorBrush x:Key="EnumHeader"
                     Color="#DDF3E4"/>

    <SolidColorBrush x:Key="EnumBackground"
                     Color="#F1FAF4"/>


    <!-- ================================================= -->
    <!-- COMPOSITE                                         -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="CompositeBorder"
                     Color="#D65A31"/>

    <SolidColorBrush x:Key="CompositeHeader"
                     Color="#F9DED3"/>

    <SolidColorBrush x:Key="CompositeBackground"
                     Color="#FFF5F0"/>


    <!-- ================================================= -->
    <!-- MEDIATOR                                          -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="MediatorBorder"
                     Color="#B07A00"/>

    <SolidColorBrush x:Key="MediatorHeader"
                     Color="#F5E5B8"/>

    <SolidColorBrush x:Key="MediatorBackground"
                     Color="#FFF9E8"/>


    <!-- ================================================= -->
    <!-- PROXY                                             -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="ProxyBorder"
                     Color="#5B6CFF"/>

    <SolidColorBrush x:Key="ProxyHeader"
                     Color="#E0E4FF"/>

    <SolidColorBrush x:Key="ProxyBackground"
                     Color="#F3F5FF"/>

</ResourceDictionary>