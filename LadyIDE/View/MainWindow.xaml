<Window x:Class="LadyIDE.WPF.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:richCanvas="clr-namespace:RichCanvas;assembly=RichCanvas"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="LadyIDE"
        Icon="/Assets/LadyIDELogo.ico"
        Width="1400"
        Height="850"
        MinWidth="1100"
        MinHeight="650"
        Background="{DynamicResource AppBackground}"
        WindowStartupLocation="CenterScreen">

    <!-- ========================================================= -->
    <!-- MAIN LAYOUT                                               -->
    <!-- ========================================================= -->

    <Grid>

        <Grid.RowDefinitions>

            <!-- Top menu -->
            <RowDefinition Height="48"/>

            <!-- Main content -->
            <RowDefinition Height="*"/>

            <!-- Status bar -->
            <RowDefinition Height="25"/>

        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- TOP MENU BAR                                          -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                Background="{DynamicResource MenuBackground}"
                BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="0,0,0,1">

            <DockPanel>

                <!-- Logo -->

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="14,0,20,0">

                    <Border Width="26"
                            Height="26"
                            Background="{DynamicResource Accent}"
                            CornerRadius="5"
                            Margin="0,0,9,0">

                        <TextBlock Text="L"
                                   Foreground="{DynamicResource AccentForeground}"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                    <TextBlock Text="LadyIDE"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                </StackPanel>


                <Menu Style="{StaticResource TopMenu}">

                    <!-- File -->

                    <MenuItem Header="File"
                              Style="{StaticResource TopMenuItem}">

                        <MenuItem Header="Load"
                                  Command="{Binding LoadFileCommand}"
                                  Style="{StaticResource SubMenuItem}"/>

                        <MenuItem Header="Save"
                                  Command="{Binding SaveFileCommand}"
                                  Style="{StaticResource SubMenuItem}"/>

                    </MenuItem>


                    <!-- View -->

                    <MenuItem Header="View"
                              Style="{StaticResource TopMenuItem}">

                        <MenuItem Header="{Binding ShowLadyElementsText}"
                                  Command="{Binding ShowLadyElementsButtonClicked}"
                                  Style="{StaticResource SubMenuItem}"/>

                        <MenuItem Header="{Binding ColorThemeText}"
                                  Command="{Binding ColorThemeButtonClicked}"
                                  Style="{StaticResource SubMenuItem}"/>

                    </MenuItem>


                    <!-- Help -->

                    <MenuItem Header="Help"
                              Style="{StaticResource TopMenuItem}">
                    </MenuItem>


                    <Separator Width="1"
                               Margin="12,10"
                               Background="{DynamicResource PanelBorder}"/>


                    <!-- Undo -->

                    <MenuItem Style="{StaticResource TopMenuItem}"
                              Header="↶"
                              FontSize="20"/>


                    <!-- Redo -->

                    <MenuItem Style="{StaticResource TopMenuItem}"
                              Header="↷"
                              FontSize="20"/>

                </Menu>


                <!-- Compile -->

                <Border DockPanel.Dock="Right"
                        Margin="0,7,14,7"
                        Background="{DynamicResource InputBackground}"
                        Width="100"
                        HorizontalAlignment="Right"
                        CornerRadius="5">

                    <Button Content="▶ Compile"
                            Style="{StaticResource CompileButtonStyle}"/>

                </Border>

            </DockPanel>

        </Border>


        <!-- ===================================================== -->
        <!-- MAIN AREA                                             -->
        <!-- ===================================================== -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <!-- Left palette -->

                <ColumnDefinition Width="{Binding LadyElementsColumnWidth}"/>

                <!-- Center -->

                <ColumnDefinition Width="*"/>

                <!-- Right properties -->

                <ColumnDefinition Width="245"/>

            </Grid.ColumnDefinitions>


            <!-- ================================================= -->
            <!-- LEFT PALETTE                                      -->
            <!-- ================================================= -->

            <Border Grid.Column="0"
                    Background="{DynamicResource PaletteBackground}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="0,0,1,0">

                <DockPanel>


                    <!-- Header -->

                    <Grid DockPanel.Dock="Top"
                          Height="54">

                        <TextBlock Text="LADY Elements"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="15,0"/>

                        <Button Content="x"
                                Style="{StaticResource CompileButtonStyle}"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center"
                                 Margin="0,0,14,0"
                                 Command="{Binding ShowLadyElementsButtonClicked}"/>

                    </Grid>


                    <!-- Elements -->

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="10,5">


                            <!-- SYSTEM -->

                            <Button Style="{StaticResource PaletteButton}">

                                <StackPanel Orientation="Horizontal">

                                    <Border Width="27"
                                            Height="27"
                                            Background="{DynamicResource SystemBorder}"
                                            CornerRadius="4"
                                            Margin="0,0,10,0">

                                        <TextBlock Text="▣"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                    <TextBlock Text="System"
                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>


                            <!-- SUBSYSTEM -->

                            <Button Style="{StaticResource PaletteButton}">

                                <StackPanel Orientation="Horizontal">

                                    <Border Width="27"
                                            Height="27"
                                            Background="{DynamicResource SubsystemBorder}"
                                            CornerRadius="4"
                                            Margin="0,0,10,0">

                                        <TextBlock Text="▣"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                    <TextBlock Text="Subsystem"
                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>


                            <!-- COMPONENT -->

                            <Button Style="{StaticResource PaletteButton}">

                                <StackPanel Orientation="Horizontal">

                                    <Border Width="27"
                                            Height="27"
                                            Background="{DynamicResource ComponentBorder}"
                                            CornerRadius="4"
                                            Margin="0,0,10,0">

                                        <TextBlock Text="▣"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                    <TextBlock Text="Component"
                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>


                            <!-- INTERFACE -->

                            <Button Style="{StaticResource PaletteButton}">

                                <StackPanel Orientation="Horizontal">

                                    <Border Width="27"
                                            Height="27"
                                            Background="{DynamicResource InterfaceBorder}"
                                            CornerRadius="4"
                                            Margin="0,0,10,0">

                                        <TextBlock Text="○"
                                                   Foreground="White"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                    <TextBlock Text="Interface"
                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>


                            <!-- PATTERN -->

                            <Button Style="{StaticResource PaletteButton}">

                                <StackPanel Orientation="Horizontal">

                                    <Border Width="27"
                                            Height="27"
                                            Background="{DynamicResource EntityBorder}"
                                            CornerRadius="4"
                                            Margin="0,0,10,0">

                                        <TextBlock Text="◇"
                                                   Foreground="White"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                    <TextBlock Text="Pattern"
                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>


                            <Separator Margin="3,10"/>


                            <!-- CONNECTION -->

                            <Button Style="{StaticResource PaletteButton}">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="→"
                                               Foreground="{DynamicResource Accent}"
                                               FontSize="23"
                                               Width="37"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="Connection"
                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>


                            <!-- NOTE -->

                            <Button Style="{StaticResource PaletteButton}">

                                <StackPanel Orientation="Horizontal">

                                    <Border Width="27"
                                            Height="27"
                                            Background="{DynamicResource TextSecondary}"
                                            CornerRadius="4"
                                            Margin="0,0,10,0">

                                        <TextBlock Text="□"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                    <TextBlock Text="Note"
                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>

                        </StackPanel>

                    </ScrollViewer>

                </DockPanel>

            </Border>


            <!-- ================================================= -->
            <!-- CENTER                                            -->
            <!-- ================================================= -->

            <Grid Grid.Column="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="250"/>
                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- CANVAS                                             -->
                <!-- ================================================= -->

                <Grid>
                    <!-- Bind your dynamic collection directly to the RichCanvas control -->
                    <richCanvas:RichCanvas>

                        <!-- Define the visual appearance of each canvas object -->
                        <richCanvas:RichCanvas.ItemTemplate>
                            <DataTemplate>
                                <Border Background="RoyalBlue" CornerRadius="4" Width="100" Height="60">
                                    <TextBlock Text="{Binding Name}" 
                                   Foreground="White" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </richCanvas:RichCanvas.ItemTemplate>

                    </richCanvas:RichCanvas>
                </Grid>

                <!-- ================================================= -->
                <!-- RESIZE BAR                                        -->
                <!-- ================================================= -->
                
                <GridSplitter
                    Grid.Row="1"
                    Height="10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource PanelBorder}"
                    ResizeDirection="Rows"
                    ResizeBehavior="PreviousAndNext"/>

                <!-- ================================================= -->
                <!-- CODE PANEL                                        -->
                <!-- ================================================= -->

                <Border Grid.Row="2"
                        Background="{DynamicResource CodeBackground}"
                        BorderBrush="{DynamicResource PanelBorder}"
                        BorderThickness="0,1,0,0">

                    <TabControl Style="{StaticResource CodeTabControl}">

                        <!-- CODE -->
                        <TabItem Header="Code"
                                 Style="{StaticResource CodeTabItem}">

                            <TabItem.Content>
                                <Grid Background="{DynamicResource CodeBackground}">

                                    <Grid.Resources>

                                        <Style TargetType="{x:Type ScrollBar}"
                                               BasedOn="{StaticResource CodeScrollBar}"/>

                                        <Style TargetType="{x:Type ScrollViewer}"
                                               BasedOn="{StaticResource CodeScrollViewer}"/>

                                    </Grid.Resources>

                                    <avalonEdit:TextEditor
                                                x:Name="CodeEditor"
                                                Background="{DynamicResource CodeBackground}"
                                                Foreground="{DynamicResource CodeForeground}"
                                                FontFamily="Consolas"
                                                FontSize="14"
                                                ShowLineNumbers="True"
                                                HorizontalScrollBarVisibility="Auto"
                                                VerticalScrollBarVisibility="Auto"
                                                Padding="12,8"/>        

                                </Grid>
                            </TabItem.Content>

                        </TabItem>


                        <!-- CONSOLE -->
                        <TabItem Header="Console"
                                 Style="{StaticResource CodeTabItem}">

                            <TabItem.Content>
                                <Grid Background="{DynamicResource CodeBackground}">

                                    <TextBox Style="{StaticResource ConsoleTextBox}"/>

                                </Grid>
                            </TabItem.Content>

                        </TabItem>

                    </TabControl>

                </Border>

            </Grid>


            <!-- ================================================= -->
            <!-- RIGHT PROPERTIES                                  -->
            <!-- ================================================= -->

            <Border Grid.Column="2"
                    Background="{DynamicResource PropertiesBackground}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="1,0,0,0">

            </Border>

        </Grid>

        <!-- ===================================================== -->
        <!-- STATUS BAR                                            -->
        <!-- ===================================================== -->

        <Border Grid.Row="2"
                Background="{DynamicResource StatusBarBackground}">

            <DockPanel>

                <TextBlock Text="{Binding CaretPositionText}"
                           Foreground="{DynamicResource StatusBarForeground}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Right"
                           Margin="0,0,15,0"/>

            </DockPanel>

        </Border>

    </Grid>

</Window>
