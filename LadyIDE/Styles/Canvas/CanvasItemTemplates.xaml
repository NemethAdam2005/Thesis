    <!-- ================================================= -->
    <!-- PARAMETER TEMPLATE                                -->
    <!-- ================================================= -->

    <DataTemplate DataType="{x:Type canvasElements:Parameter}">

        <Border
        Style="{StaticResource ParameterCanvasItemStyle}"
        Padding="8,5"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        behaviors:CommandBehavior.Command="{Binding DataContext.SelectItemCommand,
        RelativeSource={RelativeSource AncestorType=Window}}"
        behaviors:CommandBehavior.CommandParameter="{Binding}">

            <StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">

                <TextBlock
                Text="⌗"
                Foreground="{DynamicResource ParameterBorder}"
                FontSize="10"
                Margin="0,0,7,0"/>

                <TextBlock
                Text="{Binding Name}"
                Foreground="{DynamicResource ParameterNameText}"
                FontSize="11"
                FontWeight="SemiBold"/>

                <TextBlock
                Text=" : "
                Foreground="{DynamicResource ParameterHeaderText}"
                FontSize="11"/>

                <TextBlock
                Text="{Binding Type}"
                Foreground="{DynamicResource ParameterHeaderText}"
                FontSize="11"/>

            </StackPanel>

        </Border>

    </DataTemplate>


    <!-- ========================================================= -->
    <!-- FIELD TEMPLATE                                            -->
    <!-- ========================================================= -->

    <DataTemplate DataType="{x:Type canvasElements:Field}">

        <Border
        Style="{StaticResource FieldCanvasItemStyle}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="43"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ================================================= -->
                <!-- FIELD HEADER                                      -->
                <!-- ================================================= -->

                <Border
                Grid.Row="0"
                Background="{DynamicResource FieldHeader}"
                Padding="12,0"
                behaviors:CommandBehavior.Command="{Binding DataContext.SelectItemCommand,
                RelativeSource={RelativeSource AncestorType=Window}}"
                behaviors:CommandBehavior.CommandParameter="{Binding}">

                    <StackPanel
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                        <TextBlock
                        Text="▱"
                        Foreground="{DynamicResource FieldBorder}"
                        FontSize="15"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"/>

                        <TextBlock
                        Text="{Binding Name}"
                        Foreground="{DynamicResource FieldNameText}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"/>

                        <TextBlock
                        Text=" : "
                        Foreground="{DynamicResource FieldHeaderText}"
                        FontSize="13"
                        VerticalAlignment="Center"/>

                        <TextBlock
                        Text="{Binding Type}"
                        Foreground="{DynamicResource FieldHeaderText}"
                        FontSize="13"
                        VerticalAlignment="Center"/>

                        <Border
                          Background="{DynamicResource FieldBorder}"
                          CornerRadius="4"
                          Padding="5,2"
                          Margin="10,0,0,0"
                          VerticalAlignment="Center">

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>

                                    <Style.Triggers>
                                        <DataTrigger
                                              Binding="{Binding ShowLazyIndicator}"
                                              Value="True">     
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <TextBlock
                                Text="lazy"
                                Foreground="White"
                                FontSize="9"
                                FontWeight="Bold"/>           
                        </Border>

                    </StackPanel>

                </Border>

                <!-- ================================================= -->
