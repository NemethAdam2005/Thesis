<ResourceDictionary
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================= -->
    <!-- GENERAL                                          -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="AppBackground"
                         Color="#F4F6F8"/>

    <SolidColorBrush x:Key="PanelBackground"
                         Color="#FFFFFF"/>

    <SolidColorBrush x:Key="PanelBackgroundSecondary"
                         Color="#F8FAFC"/>

    <SolidColorBrush x:Key="PanelBorder"
                         Color="#D6DDE5"/>


    <!-- ================================================= -->
    <!-- TEXT                                              -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="TextPrimary"
                         Color="#17212B"/>

    <SolidColorBrush x:Key="TextSecondary"
                         Color="#687585"/>

    <SolidColorBrush x:Key="TextDisabled"
                         Color="#A6AFBA"/>


    <!-- ================================================= -->
    <!-- INPUT                                             -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="InputBackground"
                         Color="#FFFFFF"/>

    <SolidColorBrush x:Key="InputBorder"
                         Color="#C8D1DB"/>

    <SolidColorBrush x:Key="InputForeground"
                         Color="#17212B"/>


    <!-- ================================================= -->
    <!-- MENU                                              -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="MenuBackground"
                         Color="#FFFFFF"/>

    <SolidColorBrush x:Key="MenuHoverBackground"
                         Color="#E9F1F8"/>

    <SolidColorBrush x:Key="MenuBorder"
                         Color="#D6DDE5"/>


    <!-- ================================================= -->
    <!-- PALETTE                                           -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="PaletteBackground"
                         Color="#FFFFFF"/>

    <SolidColorBrush x:Key="PaletteButtonBackground"
                         Color="#FFFFFF"/>

    <SolidColorBrush x:Key="PaletteButtonHoverBackground"
                         Color="#E9F1F8"/>

    <SolidColorBrush x:Key="PaletteButtonBorder"
                         Color="#D6DDE5"/>


    <!-- ================================================= -->
    <!-- CODE                                              -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="CodeBackground"
                         Color="#FFFFFF"/>

    <SolidColorBrush x:Key="CodeForeground"
                         Color="#17212B"/>

    <SolidColorBrush x:Key="CodeBorder"
                         Color="#D6DDE5"/>


    <!-- ================================================= -->
    <!-- TABS                                              -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="TabBackground"
                         Color="#FFFFFF"/>

    <SolidColorBrush x:Key="TabSelectedBackground"
                         Color="#E9F1F8"/>

    <SolidColorBrush x:Key="TabBorder"
                         Color="#1688E8"/>


    <!-- ================================================= -->
    <!-- CANVAS                                            -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="CanvasBackground"
                         Color="#F7F9FC"/>

    <SolidColorBrush x:Key="CanvasGridDot"
                         Color="#DCE3EB"/>


    <!-- ================================================= -->
    <!-- STATUS BAR                                        -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="StatusBarBackground"
                         Color="#E9EDF2"/>

    <SolidColorBrush x:Key="StatusBarForeground"
                         Color="#687585"/>


    <!-- ================================================= -->
    <!-- ACCENT                                            -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="Accent"
                         Color="#1688E8"/>

    <SolidColorBrush x:Key="AccentHover"
                         Color="#0E73C7"/>

    <SolidColorBrush x:Key="AccentForeground"
                         Color="#FFFFFF"/>


    <!-- ================================================= -->
    <!-- PROPERTIES                                        -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="PropertiesBackground"
                         Color="#EEF2F6"/>

    <SolidColorBrush x:Key="PropertiesSectionHeader"
                         Color="#536170"/>


    <!-- ================================================= -->
    <!-- SCROLLBAR                                         -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="ScrollBarThumb"
                         Color="#B8C3CF"/>

    <SolidColorBrush x:Key="ScrollBarThumbHover"
                         Color="#8F9EAD"/>

    <SolidColorBrush x:Key="CodeScrollBarButtonBackground"
                         Color="#E5E5E5"/>

    <SolidColorBrush x:Key="CodeScrollBarHoverBackground"
                         Color="#DADADA"/>


    <!-- ================================================= -->
    <!-- DELETE BUTTON                                     -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="DeleteButtonBackground"
                         Color="#E05252"/>

    <SolidColorBrush x:Key="DeleteButtonForeground"
                         Color="#FFFFFF"/>

    <SolidColorBrush x:Key="XDeleteButtonForeground"
                Color="#28282B"/>


    <!-- ================================================= -->
    <!-- APPLICATION                                       -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="ApplicationBorder"
                     Color="#1688E8"/>

    <SolidColorBrush x:Key="ApplicationHeader"
                     Color="#D5EBFF"/>

    <SolidColorBrush x:Key="ApplicationBackground"
                     Color="#F0F8FF"/>

    <SolidColorBrush x:Key="ApplicationHeaderText"
                     Color="#1264A3"/>

    <SolidColorBrush x:Key="ApplicationNameText"
                     Color="#173B5C"/>


    <!-- ================================================= -->
    <!-- COMMAND                                           -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="CommandBorder"
                     Color="#00B8A9"/>

    <SolidColorBrush x:Key="CommandHeader"
                     Color="#CFF7F2"/>

    <SolidColorBrush x:Key="CommandBackground"
                     Color="#EEFCFA"/>

    <SolidColorBrush x:Key="CommandHeaderText"
                     Color="#00796F"/>

    <SolidColorBrush x:Key="CommandNameText"
                     Color="#174F4A"/>


    <!-- ================================================= -->
    <!-- COMPONENT                                         -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="ComponentBorder"
                     Color="#8048D8"/>

    <SolidColorBrush x:Key="ComponentHeader"
                     Color="#E6D8FF"/>

    <SolidColorBrush x:Key="ComponentBackground"
                     Color="#F7F2FF"/>

    <SolidColorBrush x:Key="ComponentHeaderText"
                     Color="#6032B0"/>

    <SolidColorBrush x:Key="ComponentNameText"
                     Color="#3E286B"/>


    <!-- ================================================= -->
    <!-- RECORD                                            -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="RecordBorder"
                     Color="#F07818"/>

    <SolidColorBrush x:Key="RecordHeader"
                     Color="#FFE0C2"/>

    <SolidColorBrush x:Key="RecordBackground"
                     Color="#FFF5EA"/>

    <SolidColorBrush x:Key="RecordHeaderText"
                     Color="#B24F00"/>

    <SolidColorBrush x:Key="RecordNameText"
                     Color="#71370D"/>


    <!-- ================================================= -->
    <!-- ENTITY                                            -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="EntityBorder"
                     Color="#E52E9B"/>

    <SolidColorBrush x:Key="EntityHeader"
                     Color="#FFD4ED"/>

    <SolidColorBrush x:Key="EntityBackground"
                     Color="#FFF0F8"/>

    <SolidColorBrush x:Key="EntityHeaderText"
                     Color="#A51F6D"/>

    <SolidColorBrush x:Key="EntityNameText"
                     Color="#681F49"/>


    <!-- ================================================= -->
    <!-- ENUMELEMENT                                       -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="EnumElementBorder"
                     Color="#25A96A"/>

    <SolidColorBrush x:Key="EnumElementHeader"
                     Color="#D2F2E0"/>

    <SolidColorBrush x:Key="EnumElementBackground"
                     Color="#EFFAF4"/>

    <SolidColorBrush x:Key="EnumElementHeaderText"
                     Color="#197A4A"/>

    <SolidColorBrush x:Key="EnumElementNameText"
                     Color="#1E4D35"/>


    <!-- ================================================= -->
    <!-- COMPOSITE                                         -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="CompositeBorder"
                     Color="#E04444"/>

    <SolidColorBrush x:Key="CompositeHeader"
                     Color="#FFD7D7"/>

    <SolidColorBrush x:Key="CompositeBackground"
                     Color="#FFF0F0"/>

    <SolidColorBrush x:Key="CompositeHeaderText"
                     Color="#A92828"/>

    <SolidColorBrush x:Key="CompositeNameText"
                     Color="#642323"/>


    <!-- ================================================= -->
    <!-- MEDIATOR                                          -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="MediatorBorder"
                     Color="#D6B400"/>

    <SolidColorBrush x:Key="MediatorHeader"
                     Color="#FFF0A8"/>

    <SolidColorBrush x:Key="MediatorBackground"
                     Color="#FFFBE1"/>

    <SolidColorBrush x:Key="MediatorHeaderText"
                     Color="#8C7400"/>

    <SolidColorBrush x:Key="MediatorNameText"
                     Color="#5E5100"/>


    <!-- ================================================= -->
    <!-- PROXY                                             -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="ProxyBorder"
                     Color="#5666D8"/>

    <SolidColorBrush x:Key="ProxyHeader"
                     Color="#DDE1FF"/>

    <SolidColorBrush x:Key="ProxyBackground"
                     Color="#F1F3FF"/>

    <SolidColorBrush x:Key="ProxyHeaderText"
                     Color="#3F4DA8"/>

    <SolidColorBrush x:Key="ProxyNameText"
                     Color="#293466"/>

    <!-- ================================================= -->
    <!-- INPUT                                             -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="InputElementBorder" Color="#E11D48"/>
    <SolidColorBrush x:Key="InputElementHeader" Color="#FFE0E7"/>
    <SolidColorBrush x:Key="InputElementBackground" Color="#FFF2F5"/>
    <SolidColorBrush x:Key="InputElementHeaderText" Color="#B3143A"/>
    <SolidColorBrush x:Key="InputElementNameText" Color="#68172C"/>

    <!-- ================================================= -->
    <!-- PARAMETER                                         -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="ParameterBorder"
                     Color="#0284C7"/>

    <SolidColorBrush x:Key="ParameterHeader"
                     Color="#DFF4FF"/>

    <SolidColorBrush x:Key="ParameterBackground"
                     Color="#F0FAFF"/>

    <SolidColorBrush x:Key="ParameterHeaderText"
                     Color="#075985"/>

    <SolidColorBrush x:Key="ParameterNameText"
                     Color="#123B52"/>

    <!-- ================================================= -->
    <!-- PROPERTY COMBOBOX HOVER                           -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="PropertyComboBoxHover" Color="#8F9EAD"/>
    
</ResourceDictionary>