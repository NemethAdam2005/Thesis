                Background="{DynamicResource ComponentHeader}"
                Padding="12,0"
                behaviors:CommandBehavior.Command="{Binding DataContext.SelectItemCommand,
                RelativeSource={RelativeSource AncestorType=Window}}"
                behaviors:CommandBehavior.CommandParameter="{Binding}">

                    <StackPanel
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                        <TextBlock
                        Text="◆"
                        Foreground="{DynamicResource ComponentBorder}"
                        FontSize="15"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"/>

                        <TextBlock
