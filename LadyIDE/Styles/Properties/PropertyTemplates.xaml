<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvasElements="clr-namespace:LadyIDE.WPF.CanvasElements">

	<!-- ========================================================= -->
	<!-- APPLICATION PROPERTIES                                    -->
	<!-- ========================================================= -->

	<DataTemplate DataType="{x:Type canvasElements:ConsoleApplication}">

		<ScrollViewer VerticalScrollBarVisibility="Auto">

			<StackPanel Margin="15">

				<!-- ================================================= -->
				<!-- PROPERTIES HEADER                                 -->
				<!-- ================================================= -->

				<DockPanel Margin="0,0,0,18">

					<TextBlock
                        Text="Properties"
                        Foreground="{DynamicResource TextPrimary}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"/>

					<Button
                        Content="x"
                        Style="{StaticResource ClosePropertiesButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,14,0"
                        Command="{Binding DataContext.ShowPropertiesButtonClicked,
                                          RelativeSource={RelativeSource AncestorType=Window}}"/>

				</DockPanel>


				<!-- ================================================= -->
				<!-- TYPE                                              -->
				<!-- ================================================= -->

				<StackPanel Orientation="Horizontal"
                            Margin="0,0,0,15">

					<Border
                        Width="27"
                        Height="27"
                        Background="{DynamicResource ApplicationBorder}"
                        CornerRadius="4"
                        Margin="0,0,10,0">

						<TextBlock
                            Text="▣"
                            Foreground="White"
                            FontSize="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

					</Border>

					<TextBlock
                        Text="Application"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource TextPrimary}"
                        FontSize="12"/>

				</StackPanel>


				<!-- ================================================= -->
				<!-- NAME                                              -->
				<!-- ================================================= -->

				<TextBlock
                    Text="Name"
                    Foreground="{DynamicResource PropertiesSectionHeader}"
                    FontSize="12"
                    Margin="0,0,0,5"/>

				<TextBox
                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                    Background="{DynamicResource InputBackground}"
                    BorderBrush="{DynamicResource InputBorder}"
                    Foreground="{DynamicResource InputForeground}"
                    Padding="8,6"
                    Margin="0,0,0,15"/>


				<!-- ================================================= -->
				<!-- COMMANDS                                           -->
				<!-- ================================================= -->

				<TextBlock
                    Text="Commands"
                    Foreground="{DynamicResource PropertiesSectionHeader}"
                    FontSize="12"
                    Margin="0,0,0,8"/>


				<ItemsControl ItemsSource="{Binding Children}">

					<ItemsControl.ItemTemplate>

						<DataTemplate>

							<Grid Margin="0,0,0,6">

								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="32"/>
								</Grid.ColumnDefinitions>


								<!-- Command name -->

								<Border
                                    Grid.Column="0"
                                    Background="{DynamicResource InputBackground}"
                                    BorderBrush="{DynamicResource InputBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,6">

									<TextBlock
                                        Text="{Binding Name}"
                                        Foreground="{DynamicResource TextPrimary}"
                                        VerticalAlignment="Center"/>

								</Border>


								<!-- Delete command -->

								<Button
                                    Grid.Column="1"
                                    Width="28"
                                    Height="28"
                                    Margin="5,0,0,0"
                                    Content="✕"
                                    Foreground="{DynamicResource XDeleteButtonForeground}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="13"
                                    Command="{Binding DataContext.DeleteItemCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>

							</Grid>

						</DataTemplate>

					</ItemsControl.ItemTemplate>

				</ItemsControl>


				<!-- ================================================= -->
				<!-- ADD COMMAND                                        -->
				<!-- ================================================= -->

				<Button
					Style="{DynamicResource AddButtonStyle}"
					Content="Add Command"
					Command="{Binding DataContext.AddCommandToApplicationCommand,
							  RelativeSource={RelativeSource AncestorType=Window}}"
					CommandParameter="{Binding}"/>


				<!-- ================================================= -->
				<!-- DELETE APPLICATION                                 -->
				<!-- ================================================= -->

				<Button
					Style="{DynamicResource DeleteButtonStyle}"
					Content="DELETE"
					Command="{Binding DataContext.DeleteItemCommand,
							RelativeSource={RelativeSource AncestorType=Window}}"
					CommandParameter="{Binding}"/>

			</StackPanel>

		</ScrollViewer>

	</DataTemplate>


	<!-- ========================================================= -->
	<!-- COMMAND PROPERTIES                                        -->
	<!-- ========================================================= -->

	<DataTemplate DataType="{x:Type canvasElements:Command}">

		<ScrollViewer VerticalScrollBarVisibility="Auto">

			<StackPanel Margin="15">

				<!-- ================================================= -->
				<!-- PROPERTIES HEADER                                 -->
				<!-- ================================================= -->

				<DockPanel Margin="0,0,0,18">

					<TextBlock
						Text="Properties"
						Foreground="{DynamicResource TextPrimary}"
						FontSize="14"
						FontWeight="SemiBold"
						VerticalAlignment="Center"/>

					<Button
						Content="x"
						Style="{StaticResource ClosePropertiesButtonStyle}"
						HorizontalAlignment="Right"
						VerticalAlignment="Center"
						Margin="0,0,14,0"
						Command="{Binding DataContext.ShowPropertiesButtonClicked,
                                      RelativeSource={RelativeSource AncestorType=Window}}"/>

				</DockPanel>


				<!-- ================================================= -->
				<!-- TYPE                                              -->
				<!-- ================================================= -->

				<StackPanel Orientation="Horizontal"
							Margin="0,0,0,15">

					<Border
						Width="27"
						Height="27"
						Background="{DynamicResource CommandBorder}"
						CornerRadius="4"
						Margin="0,0,10,0">

						<TextBlock
							Text="▤"
							Foreground="White"
							FontSize="12"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"/>

					</Border>

					<TextBlock
						Text="Command"
						VerticalAlignment="Center"
						HorizontalAlignment="Center"
						Foreground="{DynamicResource TextPrimary}"
						FontSize="12"/>

				</StackPanel>


				<!-- ================================================= -->
				<!-- NAME                                              -->
				<!-- ================================================= -->

				<TextBlock
					Text="Name"
					Foreground="{DynamicResource PropertiesSectionHeader}"
					FontSize="12"
					Margin="0,0,0,5"/>

				<TextBox
					Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
					Background="{DynamicResource InputBackground}"
					BorderBrush="{DynamicResource InputBorder}"
					Foreground="{DynamicResource InputForeground}"
					Padding="8,6"
					Margin="0,0,0,15"/>

				<!-- ================================================= -->
				<!-- ACTION                                              -->
				<!-- ================================================= -->

				<TextBlock
					Text="Action"
					Foreground="{DynamicResource PropertiesSectionHeader}"
					FontSize="12"
					Margin="0,15,0,5"/>

                <TextBlock
                    Text="The Action container holds references to existing Action elements."
                    Foreground="{DynamicResource TextSecondary}"
                    FontSize="11"
                    TextWrapping="Wrap"
                    Margin="0,0,0,10"/>

                <!-- ================================================= -->
                <!-- ACTION REFERENCE                                  -->
                <!-- ================================================= -->

                <ContentControl Content="{Binding ActionReference}" Margin="0,0,0,6">

                    <ContentControl.Style>
                        <Style TargetType="{x:Type ContentControl}">
                            <Setter Property="Visibility" Value="Visible"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActionReference}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>

                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>

                                <!-- ActionReference neve -->
                                <Border
                                    Grid.Column="0"
                                    Background="{DynamicResource InputBackground}"
                                    BorderBrush="{DynamicResource InputBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,6">

                                    <TextBlock
                                        Text="{Binding Name}"
                                        Foreground="{DynamicResource TextPrimary}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"/>      
                                </Border>

                                <!-- ActionReference törlése -->
                                <Button
                                    Grid.Column="1"
                                    Width="28"
                                    Height="28"
                                    Margin="5,0,0,0"
                                    Content="✕"
                                    Foreground="{DynamicResource XDeleteButtonForeground}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="13"
                                    Command="{Binding DataContext.DeleteItemCommand,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>

                            </Grid>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>

                </ContentControl>

                <ComboBox
                    Style="{DynamicResource PropertyComboBoxStyle}"
                    ItemsSource="{Binding DataContext.AvailableActions,
                        RelativeSource={RelativeSource AncestorType=Window}}"
                    SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
                    DisplayMemberPath="Name"
                    Height="32"
                    Margin="0,0,0,12">  

                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                </ComboBox>

                <Button
                    Content="Add Action"
                    Command="{Binding DataContext.AddActionReferenceToCommandCommand,
                        RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    Margin="0,0,0,12">  

                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource AddButtonStyle}">
                            <Setter Property="IsEnabled" Value="True"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedAction}" Value="{x:Null}">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- ================================================= -->
				<!-- INPUTS                                             -->
				<!-- ================================================= -->

				<StackPanel Orientation="Horizontal">
					<TextBlock
					Text="Input -"
					Foreground="{DynamicResource PropertiesSectionHeader}"
					FontSize="12"
					Margin="0,0,0,8"/>
					<TextBlock
					Text=" (Only one input allowed)"
					Foreground="{DynamicResource PropertiesSectionHeader}"
					FontSize="12"
					FontWeight="SemiBold"
					Margin="0,0,0,8"/>
				</StackPanel>


				<ContentControl Content="{Binding Input}">
                    <ContentControl.Style>
                        <Style TargetType="{x:Type ContentControl}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Input}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>

                    <ContentControl.ContentTemplate>

						<DataTemplate DataType="{x:Type canvasElements:Input}">

							<Grid Margin="0,0,0,6">

								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="32"/>
								</Grid.ColumnDefinitions>


								<!-- Input name -->

								<Border
								   Grid.Column="0"
								   Background="{DynamicResource InputBackground}"
								   BorderBrush="{DynamicResource InputBorder}"
								   BorderThickness="1"
								   CornerRadius="4"
								   Padding="8,6">

									<TextBlock
                                        Text="Input"
                                        Foreground="{DynamicResource TextPrimary}"
                                        VerticalAlignment="Center"/>

								</Border>

								<!-- Delete input -->

								<Button
									Grid.Column="2"
									Width="28"
									Height="28"
									Margin="5,0,0,0"
									Content="✕"
									Foreground="{DynamicResource XDeleteButtonForeground}"
									Background="Transparent"
									BorderThickness="0"
									FontSize="13"
									Command="{Binding DataContext.DeleteItemCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
									CommandParameter="{Binding}"/>

							</Grid>

						</DataTemplate>

					</ContentControl.ContentTemplate>

				</ContentControl>


				<!-- ================================================= -->
				<!-- ADD INPUT                                          -->
				<!-- ================================================= -->

				<Button
					Style="{DynamicResource AddButtonStyle}"
					Content="Add Input"
					Command="{Binding DataContext.AddInputToCommandCommand,
							  RelativeSource={RelativeSource AncestorType=Window}}"
					CommandParameter="{Binding}"
/>

				<!-- ================================================= -->
				<!-- DELETE COMMAND                                     -->
				<!-- ================================================= -->

				<Button
					Style="{DynamicResource DeleteButtonStyle}"
					Content="DELETE"
					Command="{Binding DataContext.DeleteItemCommand,
							  RelativeSource={RelativeSource AncestorType=Window}}"
					CommandParameter="{Binding}"/>

			</StackPanel>

		</ScrollViewer>

	</DataTemplate>


	<!-- ========================================================= -->
	<!-- INPUT PROPERTIES                                          -->
	<!-- ========================================================= -->

	<DataTemplate DataType="{x:Type canvasElements:Input}">

		<ScrollViewer VerticalScrollBarVisibility="Auto">

			<StackPanel Margin="15">

				<!-- ================================================= -->
				<!-- PROPERTIES HEADER                                 -->
				<!-- ================================================= -->

				<DockPanel Margin="0,0,0,18">

					<TextBlock
						Text="Properties"
						Foreground="{DynamicResource TextPrimary}"
						FontSize="14"
						FontWeight="SemiBold"
						VerticalAlignment="Center"/>

					<Button
						Content="x"
						Style="{StaticResource ClosePropertiesButtonStyle}"
						HorizontalAlignment="Right"
						VerticalAlignment="Center"
						Margin="0,0,14,0"
						Command="{Binding DataContext.ShowPropertiesButtonClicked,
                                      RelativeSource={RelativeSource AncestorType=Window}}"/>

				</DockPanel>


				<!-- ================================================= -->
				<!-- TYPE                                              -->
				<!-- ================================================= -->

				<StackPanel Orientation="Horizontal"
							Margin="0,0,0,15">

					<Border
						Width="27"
						Height="27"
						Background="{DynamicResource InputElementBorder}"
						CornerRadius="4"
						Margin="0,0,10,0">

						<TextBlock
							Text="○"
							Foreground="White"
							FontSize="12"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"/>

					</Border>

					<TextBlock
						Text="Input"
						VerticalAlignment="Center"
						HorizontalAlignment="Center"
						Foreground="{DynamicResource TextPrimary}"
						FontSize="12"/>

				</StackPanel>

				<!-- ================================================= -->
				<!-- PARAMETERS                                         -->
				<!-- ================================================= -->

				<TextBlock
					Text="Parameters"
					Foreground="{DynamicResource PropertiesSectionHeader}"
					FontSize="12"
					Margin="0,0,0,8"/>


				<ItemsControl ItemsSource="{Binding Children}">

					<ItemsControl.ItemTemplate>

						<DataTemplate DataType="{x:Type canvasElements:Parameter}">

							<Grid Margin="0,0,0,6">

								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="32"/>
								</Grid.ColumnDefinitions>


								<!-- Parameter name -->

								<Border
									Grid.Column="0"
									Background="{DynamicResource InputBackground}"
									BorderBrush="{DynamicResource InputBorder}"
									BorderThickness="1"
									CornerRadius="4"
									Padding="8,6">

									<TextBlock
										Text="{Binding Name}"
										Foreground="{DynamicResource TextPrimary}"
										VerticalAlignment="Center"/>

								</Border>


								<!-- Delete parameter -->

								<Button
									Grid.Column="1"
									Width="28"
									Height="28"
									Margin="5,0,0,0"
									Content="✕"
									Foreground="{DynamicResource XDeleteButtonForeground}"
									Background="Transparent"
									BorderThickness="0"
									FontSize="13"
									Command="{Binding DataContext.DeleteItemCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
									CommandParameter="{Binding}"/>

							</Grid>

						</DataTemplate>

					</ItemsControl.ItemTemplate>

				</ItemsControl>


				<!-- ================================================= -->
				<!-- ADD PARAMETER                                      -->
				<!-- ================================================= -->

				<Button
					Style="{DynamicResource AddButtonStyle}"
					Content="Add Parameter"
					Command="{Binding DataContext.AddParameterToInputCommand,
                              RelativeSource={RelativeSource AncestorType=Window}}"
					CommandParameter="{Binding}"/>


				<!-- ================================================= -->
				<!-- DELETE INPUT                                       -->
				<!-- ================================================= -->

				<Button
					Style="{DynamicResource DeleteButtonStyle}"
					Content="DELETE"
					Command="{Binding DataContext.DeleteItemCommand,
                              RelativeSource={RelativeSource AncestorType=Window}}"
					CommandParameter="{Binding}"/>

			</StackPanel>

		</ScrollViewer>

	</DataTemplate>

	<!-- ================================================= -->
	<!-- PARAMETER PROPERTY                                -->
	<!-- ================================================= -->
	
	<DataTemplate DataType="{x:Type canvasElements:Parameter}">
		<ScrollViewer VerticalScrollBarVisibility="Auto">
			<StackPanel Margin="15">

				<DockPanel Margin="0,0,0,18">

					<TextBlock
						Text="Properties"
						Foreground="{DynamicResource TextPrimary}"
						FontSize="14"
						FontWeight="SemiBold"
						VerticalAlignment="Center"/>

					<Button
						Content="x"
						Style="{StaticResource ClosePropertiesButtonStyle}"
						HorizontalAlignment="Right"
						VerticalAlignment="Center"
						Margin="0,0,14,0"
						Command="{Binding DataContext.ShowPropertiesButtonClicked,
                                      RelativeSource={RelativeSource AncestorType=Window}}"/>

				</DockPanel>


				<StackPanel Orientation="Horizontal"
							Margin="0,0,0,15">

					<Border Width="27"
							Height="27"
							Background="{DynamicResource ParameterBorder}"
							CornerRadius="4"
							Margin="0,0,10,0">

						<TextBlock Text="⌗"
								   Foreground="White"
								   FontSize="11"
								   HorizontalAlignment="Center"
								   VerticalAlignment="Center"/>

					</Border>

					<TextBlock Text="Parameter"
							   FontSize="16"
							   FontWeight="SemiBold"
							   Foreground="{DynamicResource TextPrimary}"
							   VerticalAlignment="Center"/>

				</StackPanel>


				<TextBlock Text="Name"
						   Foreground="{DynamicResource TextSecondary}"
						   Margin="0,0,0,5"/>

				<TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
						 Background="{DynamicResource InputBackground}"
						 BorderBrush="{DynamicResource InputBorder}"
						 Foreground="{DynamicResource InputForeground}"
						 Padding="8,6"
						 Margin="0,0,0,15"/>


				<TextBlock Text="Type"
						   Foreground="{DynamicResource TextSecondary}"
						   Margin="0,0,0,5"/>

				<ComboBox
					Style="{DynamicResource PropertyComboBoxStyle}"
					ItemsSource="{Binding DataContext.InputTypes,
                                      RelativeSource={RelativeSource AncestorType=Window}}"
					SelectedItem="{Binding Type,
                                       Mode=TwoWay,
                                       UpdateSourceTrigger=PropertyChanged}"
					Height="32"
					Margin="0,0,0,15"/>


				<Button Style="{DynamicResource DeleteButtonStyle}"
						Content="DELETE"
						Command="{Binding DataContext.DeleteItemCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}"
						CommandParameter="{Binding}"/>

			</StackPanel>
		</ScrollViewer>
	</DataTemplate>
	
	<!-- ========================================================= -->
	<!-- COMPONENT PROPERTIES                                      -->
	<!-- ========================================================= -->

	<DataTemplate DataType="{x:Type canvasElements:Component}">

		<ScrollViewer VerticalScrollBarVisibility="Auto">

			<StackPanel Margin="15">

				<DockPanel Margin="0,0,0,18">

					<TextBlock
                        Text="Properties"
                        Foreground="{DynamicResource TextPrimary}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"/>

					<Button
                        Content="x"
                        Style="{StaticResource ClosePropertiesButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,14,0"
                        Command="{Binding DataContext.ShowPropertiesButtonClicked,
                                          RelativeSource={RelativeSource AncestorType=Window}}"/>

				</DockPanel>

				<StackPanel Orientation="Horizontal"
                            Margin="0,0,0,15">

					<Border
                        Width="27"
                        Height="27"
                        Background="{DynamicResource ComponentBorder}"
                        CornerRadius="4"
                        Margin="0,0,10,0">

						<TextBlock
                            Text="◆"
                            Foreground="White"
                            FontSize="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

					</Border>

					<TextBlock
                        Text="Component"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource TextPrimary}"
                        FontSize="12"/>

				</StackPanel>

				<TextBlock
                    Text="Name"
                    Foreground="{DynamicResource PropertiesSectionHeader}"
                    FontSize="12"
                    Margin="0,0,0,5"/>

				<TextBox
                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                    Background="{DynamicResource InputBackground}"
                    BorderBrush="{DynamicResource InputBorder}"
                    Foreground="{DynamicResource InputForeground}"
                    Padding="8,6"/>

                <!-- RECORD -->

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Record - "
               Foreground="{DynamicResource PropertiesSectionHeader}"
               FontSize="12"/>

                    <TextBlock Text="Only one Record allowed"
               Foreground="{DynamicResource PropertiesSectionHeader}"
               FontSize="12"
               FontWeight="SemiBold"/>
                </StackPanel>

                <ContentControl Content="{Binding Record}" Margin="0,0,0,8">
                    <ContentControl.Style>
                        <Style TargetType="{x:Type ContentControl}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Record}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>

                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                        Background="{DynamicResource InputBackground}"
                        BorderBrush="{DynamicResource InputBorder}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,6">
                                    <TextBlock Text="{Binding Name}"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center"/>
                                </Border>

                                <Button Grid.Column="1"
                        Width="28"
                        Height="28"
                        Margin="5,0,0,0"
                        Content="✕"
                        Foreground="{DynamicResource XDeleteButtonForeground}"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding DataContext.DeleteItemCommand,
                            RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <Button Style="{DynamicResource AddButtonStyle}"
        Content="Add Record"
        Command="{Binding DataContext.AddRecordToComponentCommand,
            RelativeSource={RelativeSource AncestorType=Window}}"
        CommandParameter="{Binding}"
        Margin="0,0,0,18"/>


                <!-- ACTION -->

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Action - "
               Foreground="{DynamicResource PropertiesSectionHeader}"
               FontSize="12"/>

                    <TextBlock Text="Only one Action allowed"
               Foreground="{DynamicResource PropertiesSectionHeader}"
               FontSize="12"
               FontWeight="SemiBold"/>
                </StackPanel>

                <ContentControl Content="{Binding Action}" Margin="0,0,0,8">
                    <ContentControl.Style>
                        <Style TargetType="{x:Type ContentControl}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Action}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>

                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                        Background="{DynamicResource InputBackground}"
                        BorderBrush="{DynamicResource InputBorder}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,6">
                                    <TextBlock Text="{Binding Name}"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center"/>
                                </Border>

                                <Button Grid.Column="1"
                        Width="28"
                        Height="28"
                        Margin="5,0,0,0"
                        Content="✕"
                        Foreground="{DynamicResource XDeleteButtonForeground}"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding DataContext.DeleteItemCommand,
                            RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <Button Style="{DynamicResource AddButtonStyle}"
        Content="Add Action"
        Command="{Binding DataContext.AddActionToComponentCommand,
            RelativeSource={RelativeSource AncestorType=Window}}"
        CommandParameter="{Binding}"
        Margin="0,0,0,18"/>


                <!-- MEDIATOR -->

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Mediator - "
               Foreground="{DynamicResource PropertiesSectionHeader}"
               FontSize="12"/>

                    <TextBlock Text="Only one Mediator allowed"
               Foreground="{DynamicResource PropertiesSectionHeader}"
               FontSize="12"
               FontWeight="SemiBold"/>
                </StackPanel>

                <ContentControl Content="{Binding Mediator}" Margin="0,0,0,8">
                    <ContentControl.Style>
                        <Style TargetType="{x:Type ContentControl}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Mediator}" Value="{x:Null}">
