<Window x:Class="LadyIDE.WPF.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LadyIDE"
        Width="1400"
        Height="850"
        MinWidth="1100"
        MinHeight="650"
        Background="{DynamicResource AppBackground}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- ===================================================== -->
        <!-- LEFT PALETTE BUTTON                                   -->
        <!-- ===================================================== -->

        <Style x:Key="PaletteButton"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimary}"/>

            <Setter Property="Background"
                    Value="{DynamicResource PaletteButtonBackground}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource PaletteButtonBorder}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Padding"
                    Value="10,9"/>

            <Setter Property="Margin"
                    Value="0,3"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="{DynamicResource PaletteButtonHoverBackground}"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ===================================================== -->
        <!-- PROPERTY TEXTBOX                                      -->
        <!-- ===================================================== -->

        <Style x:Key="PropertyTextBox"
               TargetType="TextBox">

            <Setter Property="Foreground"
                    Value="{DynamicResource InputForeground}"/>

            <Setter Property="Background"
                    Value="{DynamicResource InputBackground}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource InputBorder}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="7"/>

            <Setter Property="FontSize"
                    Value="13"/>

        </Style>


        <!-- ===================================================== -->
        <!-- SECTION HEADER                                         -->
        <!-- ===================================================== -->

        <Style x:Key="SectionHeader"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="{DynamicResource PropertiesSectionHeader}"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Margin"
                    Value="0,14,0,6"/>

        </Style>


        <!-- ===================================================== -->
        <!-- TOP MENU ITEMS                                        -->
        <!-- ===================================================== -->

        <Style x:Key="TopMenu"
               TargetType="Menu">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimary}"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>


        <Style x:Key="TopMenuItem"
               TargetType="MenuItem">

            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimary}"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Padding"
                    Value="12,7"/>

            <Setter Property="Margin"
                    Value="2,0"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="{DynamicResource MenuHoverBackground}"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <Style x:Key="SubMenuItem"
               TargetType="MenuItem">

            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimary}"/>

            <Setter Property="Background"
                    Value="{DynamicResource PanelBackground}"/>

            <Setter Property="Padding"
                    Value="12,6"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="MenuItem">

                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                ContentSource="Header"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="{DynamicResource MenuHoverBackground}"/>

                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- ===================================================== -->
        <!-- TAB ITEMS                                             -->
        <!-- ===================================================== -->

        <Style x:Key="CodeTabControl"
                TargetType="TabControl">

            <Setter Property="Background"
            Value="{DynamicResource CodeBackground}"/>

            <Setter Property="BorderBrush"
            Value="{DynamicResource PanelBorder}"/>

            <Setter Property="BorderThickness"
            Value="0"/>

        </Style>


        <Style x:Key="CodeTabItem"
       TargetType="TabItem">

            <Setter Property="Foreground"
            Value="{DynamicResource TextSecondary}"/>

            <Setter Property="Background"
            Value="{DynamicResource TabBackground}"/>

            <Setter Property="BorderThickness"
            Value="0"/>

            <Setter Property="Padding"
            Value="20,0"/>

            <Setter Property="Height"
            Value="37"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TabItem">

                        <Border x:Name="TabBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Transparent"
                        BorderThickness="0,0,0,2"
                        Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                        ContentSource="Header"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Aktív tab -->
                            <Trigger Property="IsSelected"
                             Value="True">

                                <Setter TargetName="TabBorder"
                                Property="Background"
                                Value="{DynamicResource TabSelectedBackground}"/>

                                <Setter TargetName="TabBorder"
                                Property="BorderBrush"
                                Value="{DynamicResource TabBorder}"/>

                                <Setter Property="Foreground"
                                Value="{DynamicResource TextPrimary}"/>

                            </Trigger>


                            <!-- Egér fölött -->
                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Setter TargetName="TabBorder"
                                Property="Background"
                                Value="{DynamicResource MenuHoverBackground}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <!-- ========================================================= -->
    <!-- MAIN LAYOUT                                               -->
    <!-- ========================================================= -->

    <Grid>

        <Grid.RowDefinitions>

            <!-- Top menu -->
            <RowDefinition Height="48"/>

            <!-- Main content -->
            <RowDefinition Height="*"/>

            <!-- Status bar -->
            <RowDefinition Height="25"/>

        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- TOP MENU BAR                                          -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                Background="{DynamicResource MenuBackground}"
                BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="0,0,0,1">

            <DockPanel>

                <!-- Logo -->

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="14,0,20,0">

                    <Border Width="26"
                            Height="26"
                            Background="{DynamicResource Accent}"
                            CornerRadius="5"
                            Margin="0,0,9,0">

                        <TextBlock Text="L"
                                   Foreground="{DynamicResource AccentForeground}"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                    <TextBlock Text="LadyIDE"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                </StackPanel>


                <Menu Style="{StaticResource TopMenu}">

                    <!-- File -->

                    <MenuItem Header="File"
                              Style="{StaticResource TopMenuItem}">

                        <MenuItem Header="Load"
                                  Command="{Binding LoadFileCommand}"
                                  Style="{StaticResource SubMenuItem}"/>

                        <MenuItem Header="Save"
                                  Command="{Binding SaveFileCommand}"
                                  Style="{StaticResource SubMenuItem}"/>

                    </MenuItem>


                    <!-- View -->

                    <MenuItem Header="View"
                              Style="{StaticResource TopMenuItem}">

                        <MenuItem Header="{Binding ShowLadyElementsText}"
                                  Command="{Binding ShowLadyElementsButtonClicked}"
                                  Style="{StaticResource SubMenuItem}"/>

                        <MenuItem Header="{Binding ColorThemeText}"
                                  Command="{Binding ColorThemeButtonClicked}"
                                  Style="{StaticResource SubMenuItem}"/>

                    </MenuItem>


                    <!-- Help -->

                    <MenuItem Header="Help"
                              Style="{StaticResource TopMenuItem}">
                    </MenuItem>


                    <Separator Width="1"
                               Margin="12,10"
                               Background="{DynamicResource PanelBorder}"/>


                    <!-- Undo -->

                    <MenuItem Style="{StaticResource TopMenuItem}"
                              Header="↶"
                              FontSize="20"/>


                    <!-- Redo -->

                    <MenuItem Style="{StaticResource TopMenuItem}"
                              Header="↷"
                              FontSize="20"/>

                </Menu>


                <!-- Compile -->

                <Border DockPanel.Dock="Right"
                        Margin="0,7,14,7"
                        Background="{DynamicResource InputBackground}"
                        Width="100"
                        HorizontalAlignment="Right"
                        CornerRadius="5">

                    <Button Content="▶ Compile"
                            Background="Transparent"
                            Foreground="{DynamicResource TextPrimary}"
                            HorizontalAlignment="Center"
                            BorderThickness="0"
                            Cursor="Hand">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">

                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>

                                </Border>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                </Border>

            </DockPanel>

        </Border>


        <!-- ===================================================== -->
        <!-- MAIN AREA                                             -->
        <!-- ===================================================== -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <!-- Left palette -->

                <ColumnDefinition Width="{Binding LadyElementsColumnWidth}"/>

                <!-- Center -->

                <ColumnDefinition Width="*"/>

                <!-- Right properties -->

                <ColumnDefinition Width="245"/>

            </Grid.ColumnDefinitions>


            <!-- ================================================= -->
            <!-- LEFT PALETTE                                      -->
            <!-- ================================================= -->

            <Border Grid.Column="0"
                    Background="{DynamicResource PaletteBackground}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="0,0,1,0">

                <DockPanel>


                    <!-- Header -->

                    <Grid DockPanel.Dock="Top"
                          Height="54">

                        <TextBlock Text="LADY Elements"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="15,0"/>

                        <TextBlock Text="×"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="18"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0"/>

                    </Grid>


                    <!-- Elements -->

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="10,5">


                            <!-- SYSTEM -->

                            <Button Style="{StaticResource PaletteButton}">

                                <StackPanel Orientation="Horizontal">

                                    <Border Width="27"
                                            Height="27"
                                            Background="{DynamicResource SystemBorder}"
                                            CornerRadius="4"
                                            Margin="0,0,10,0">

                                        <TextBlock Text="▣"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                    <TextBlock Text="System"
                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>


                            <!-- SUBSYSTEM -->

                            <Button Style="{StaticResource PaletteButton}">

                                <StackPanel Orientation="Horizontal">

                                    <Border Width="27"
                                            Height="27"
                                            Background="{DynamicResource SubsystemBorder}"
                                            CornerRadius="4"
                                            Margin="0,0,10,0">

                                        <TextBlock Text="▣"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                    <TextBlock Text="Subsystem"
                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>


                            <!-- COMPONENT -->

                            <Button Style="{StaticResource PaletteButton}">

                                <StackPanel Orientation="Horizontal">

                                    <Border Width="27"
                                            Height="27"
                                            Background="{DynamicResource ComponentBorder}"
                                            CornerRadius="4"
                                            Margin="0,0,10,0">

                                        <TextBlock Text="▣"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                    <TextBlock Text="Component"
                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>


                            <!-- INTERFACE -->

                            <Button Style="{StaticResource PaletteButton}">

                                <StackPanel Orientation="Horizontal">

                                    <Border Width="27"
                                            Height="27"
                                            Background="{DynamicResource InterfaceBorder}"
                                            CornerRadius="4"
                                            Margin="0,0,10,0">

                                        <TextBlock Text="○"
                                                   Foreground="White"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                    <TextBlock Text="Interface"
                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>


                            <!-- PATTERN -->

                            <Button Style="{StaticResource PaletteButton}">

                                <StackPanel Orientation="Horizontal">

                                    <Border Width="27"
                                            Height="27"
                                            Background="{DynamicResource EntityBorder}"
                                            CornerRadius="4"
                                            Margin="0,0,10,0">

                                        <TextBlock Text="◇"
                                                   Foreground="White"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                    <TextBlock Text="Pattern"
                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>


                            <Separator Margin="3,10"/>


                            <!-- CONNECTION -->

                            <Button Style="{StaticResource PaletteButton}">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="→"
                                               Foreground="{DynamicResource Accent}"
                                               FontSize="23"
                                               Width="37"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="Connection"
                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>


                            <!-- NOTE -->

                            <Button Style="{StaticResource PaletteButton}">

                                <StackPanel Orientation="Horizontal">

                                    <Border Width="27"
                                            Height="27"
                                            Background="{DynamicResource TextSecondary}"
                                            CornerRadius="4"
                                            Margin="0,0,10,0">

                                        <TextBlock Text="□"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                    <TextBlock Text="Note"
                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>

                        </StackPanel>

                    </ScrollViewer>

                </DockPanel>

            </Border>


            <!-- ================================================= -->
            <!-- CENTER                                             -->
            <!-- ================================================= -->

            <Grid Grid.Column="1">

                <Grid.RowDefinitions>

                    <!-- Canvas -->

                    <RowDefinition Height="*"/>

                    <!-- Code -->

                    <RowDefinition Height="250"/>

                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- CANVAS                                             -->
                <!-- ================================================= -->

                <Border Grid.Row="0"
                        Background="{DynamicResource CanvasBackground}"
                        ClipToBounds="True">

                    <Canvas>

                    </Canvas>

                </Border>


                <!-- ================================================= -->
                <!-- CODE PANEL                                        -->
                <!-- ================================================= -->

                <Border Grid.Row="1" Background="{DynamicResource CodeBackground}" 
                        BorderBrush="{DynamicResource PanelBorder}" 
                        BorderThickness="0,1,0,0">

                    <TabControl Style="{StaticResource CodeTabControl}">
                        <TabItem Header="Code"
                                 Style="{StaticResource CodeTabItem}">
                            <TabItem.Content>
                                <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="{DynamicResource CodeBackground}" 
                                         Foreground="{DynamicResource CodeForeground}" 
                                         BorderThickness="0" 
                                         FontFamily="Consolas" 
                                         FontSize="13" 
                                         Padding="12" 
                                         AcceptsReturn="True" 
                                         AcceptsTab="True" 
                                         TextWrapping="NoWrap" 
                                         VerticalScrollBarVisibility="Auto" 
                                         HorizontalScrollBarVisibility="Auto" 
                                         IsReadOnly="False"/>
                            </TabItem.Content>
                        </TabItem>

                        <TabItem Header="Console"
                                 Style="{StaticResource CodeTabItem}">

                            <TabItem.Content>
                                <TextBox Text="" 
                                         Background="{DynamicResource CodeBackground}" 
                                         Foreground="{DynamicResource TextSecondary}" 
                                         BorderThickness="0" 
                                         FontFamily="Consolas" 
                                         FontSize="13" 
                                         Padding="12" 
                                         AcceptsReturn="True" 
                                         TextWrapping="Wrap" 
                                         VerticalScrollBarVisibility="Auto" 
                                         HorizontalScrollBarVisibility="Auto" 
                                         IsReadOnly="True" 
                                         IsTabStop="False"/>
                            </TabItem.Content>
                        </TabItem>
                    </TabControl>
                </Border>

            </Grid>


            <!-- ================================================= -->
            <!-- RIGHT PROPERTIES                                  -->
            <!-- ================================================= -->

            <Border Grid.Column="2"
                    Background="{DynamicResource PropertiesBackground}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="1,0,0,0">

            </Border>

        </Grid>

        <!-- ===================================================== -->
        <!-- STATUS BAR                                            -->
        <!-- ===================================================== -->

        <Border Grid.Row="2"
                Background="{DynamicResource StatusBarBackground}">

            <DockPanel>

                <TextBlock Text="Ready"
                           Foreground="{DynamicResource StatusBarForeground}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="12,0"/>

                <TextBlock Text="Ln 1    Col 1    UTF-8"
                           Foreground="{DynamicResource StatusBarForeground}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Right"
                           Margin="0,0,15,0"/>

            </DockPanel>

        </Border>

    </Grid>

</Window>
