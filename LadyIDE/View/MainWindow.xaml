<Window x:Class="LadyIDE.WPF.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:LadyIDE.WPF.Behaviors"
        xmlns:canvasElements="clr-namespace:LadyIDE.WPF.CanvasElements"
        xmlns:richCanvas="clr-namespace:RichCanvas;assembly=RichCanvas"
        Title="LadyIDE"
        Icon="/Assets/LadyIDELogo.ico"
        Width="1400"
        Height="850"
        MinWidth="1100"
        MinHeight="650"
        Background="{DynamicResource AppBackground}"
        WindowStartupLocation="CenterScreen">

    <!-- ========================================================= -->
    <!-- MAIN LAYOUT                                               -->
    <!-- ========================================================= -->

    <Grid>

        <Grid.RowDefinitions>

            <!-- Top menu -->
            <RowDefinition Height="48"/>

            <!-- Main content -->
            <RowDefinition Height="*"/>

            <!-- Status bar -->
            <RowDefinition Height="25"/>

        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- TOP MENU BAR                                          -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                Background="{DynamicResource MenuBackground}"
                BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="0,0,0,1">

            <DockPanel>

                <!-- Logo -->

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="14,0,20,0">

                    <Border Width="26"
                            Height="26"
                            Background="{DynamicResource Accent}"
                            CornerRadius="5"
                            Margin="0,0,9,0">

                        <TextBlock Text="L"
                                   Foreground="{DynamicResource AccentForeground}"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                    <TextBlock Text="LadyIDE"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                </StackPanel>


                <Menu Style="{StaticResource TopMenu}">

                    <!-- File -->

                    <MenuItem Header="File"
                              Style="{StaticResource TopMenuItem}">

                        <MenuItem Header="Load"
                                  Command="{Binding LoadFileCommand}"
                                  Style="{StaticResource SubMenuItem}"/>

                        <MenuItem Header="Save"
                                  Command="{Binding SaveFileCommand}"
                                  Style="{StaticResource SubMenuItem}"/>

                    </MenuItem>


                    <!-- View -->

                    <MenuItem Header="View"
                              Style="{StaticResource TopMenuItem}">

                        <MenuItem Header="{Binding ShowLadyElementsText}"
                                  Command="{Binding ShowLadyElementsButtonClicked}"
                                  Style="{StaticResource SubMenuItem}"/>

                        <MenuItem Header="{Binding ShowPropertiesText}"
                                  Command="{Binding ShowPropertiesButtonClicked}"
                                  Style="{StaticResource SubMenuItem}"/>

                        <MenuItem Header="{Binding ColorThemeText}"
                                  Command="{Binding ColorThemeButtonClicked}"
                                  Style="{StaticResource SubMenuItem}"/>
                        
                    </MenuItem>


                    <!-- Help -->

                    <MenuItem Header="Help"
                              Style="{StaticResource TopMenuItem}">
                    </MenuItem>


                    <Separator Width="1"
                               Margin="12,10"
                               Background="{DynamicResource PanelBorder}"/>


                    <!-- Undo -->

                    <MenuItem Style="{StaticResource TopMenuItem}"
                              Header="↶"
                              FontSize="20"/>


                    <!-- Redo -->

                    <MenuItem Style="{StaticResource TopMenuItem}"
                              Header="↷"
                              FontSize="20"/>

                </Menu>


                <!-- Compile -->

                <Border DockPanel.Dock="Right"
                        Margin="0,7,14,7"
                        Background="{DynamicResource InputBackground}"
                        Width="100"
                        HorizontalAlignment="Right"
                        CornerRadius="5">

                    <Button Content="▶ Compile"
                            Style="{StaticResource CompileButtonStyle}"/>

                </Border>

            </DockPanel>

        </Border>


        <!-- ===================================================== -->
        <!-- MAIN AREA                                             -->
        <!-- ===================================================== -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <!-- Left palette -->

                <ColumnDefinition Width="{Binding LadyElementsColumnWidth}"/>

                <!-- Center -->

                <ColumnDefinition Width="*"/>

                <!-- Right properties -->

                <ColumnDefinition Width="{Binding PropertiesColumnWidth}"/>

            </Grid.ColumnDefinitions>


            <!-- ================================================= -->
            <!-- LEFT PALETTE                                      -->
            <!-- ================================================= -->

            <Border Grid.Column="0"
                    Background="{DynamicResource PaletteBackground}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="0,0,1,0">

                <DockPanel>


                    <!-- Header -->

                    <Grid DockPanel.Dock="Top"
                          Height="54">

                        <TextBlock Text="LADY Elements"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="15,0"/>

                        <Button Content="x"
                                Style="{StaticResource CompileButtonStyle}"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center"
                                 Margin="0,0,14,0"
                                 Command="{Binding ShowLadyElementsButtonClicked}"/>

                    </Grid>


                    <!-- Elements -->

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Style="{StaticResource CodeScrollViewer}">

                        <StackPanel Margin="10,5">

                            <!-- APPLICATION -->

                            <Button Style="{StaticResource PaletteButton}"
                                    Command="{Binding ApplicationButtonClicked}">

                                <StackPanel Orientation="Horizontal">

                                    <Border Width="27"
                                            Height="27"
                                            Background="{DynamicResource ApplicationBorder}"
                                            CornerRadius="4"
                                            Margin="0,0,10,0">

                                        <TextBlock Text="▣"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                    <TextBlock Text="Application"
                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>


                            <!-- COMMAND -->

                            <Button Style="{StaticResource PaletteButton}"
                                    Command="{Binding CommandButtonClicked}">

                                <StackPanel Orientation="Horizontal">

                                    <Border Width="27"
                                            Height="27"
                                            Background="{DynamicResource CommandBorder}"
                                            CornerRadius="4"
                                            Margin="0,0,10,0">

                                        <TextBlock Text="▤"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                    <TextBlock Text="Command"
                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>


                            <!-- COMPONENT -->

                            <Button Style="{StaticResource PaletteButton}">

                                <StackPanel Orientation="Horizontal">

                                    <Border Width="27"
                                            Height="27"
                                            Background="{DynamicResource ComponentBorder}"
                                            CornerRadius="4"
                                            Margin="0,0,10,0">

                                        <TextBlock Text="▣"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                    <TextBlock Text="Component"
                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>


                            <!-- INTERFACE -->

                            <Button Style="{StaticResource PaletteButton}">

                                <StackPanel Orientation="Horizontal">

                                    <Border Width="27"
                                            Height="27"
                                            Background="{DynamicResource InterfaceBorder}"
                                            CornerRadius="4"
                                            Margin="0,0,10,0">

                                        <TextBlock Text="○"
                                                   Foreground="White"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                    <TextBlock Text="Interface"
                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>


                            <!-- PATTERN -->

                            <Button Style="{StaticResource PaletteButton}">

                                <StackPanel Orientation="Horizontal">

                                    <Border Width="27"
                                            Height="27"
                                            Background="{DynamicResource EntityBorder}"
                                            CornerRadius="4"
                                            Margin="0,0,10,0">

                                        <TextBlock Text="◇"
                                                   Foreground="White"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                    <TextBlock Text="Pattern"
                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>


                            <Separator Margin="3,10"/>


                            <!-- CONNECTION -->

                            <Button Style="{StaticResource PaletteButton}">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="→"
                                               Foreground="{DynamicResource Accent}"
                                               FontSize="23"
                                               Width="37"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="Connection"
                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>


                            <!-- NOTE -->

                            <Button Style="{StaticResource PaletteButton}">

                                <StackPanel Orientation="Horizontal">

                                    <Border Width="27"
                                            Height="27"
                                            Background="{DynamicResource TextSecondary}"
                                            CornerRadius="4"
                                            Margin="0,0,10,0">

                                        <TextBlock Text="□"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                    <TextBlock Text="Note"
                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </Button>

                        </StackPanel>

                    </ScrollViewer>

                </DockPanel>

            </Border>


            <!-- ================================================= -->
            <!-- CENTER                                            -->
            <!-- ================================================= -->

            <Grid Grid.Column="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="250"/>
                </Grid.RowDefinitions>

                <!-- ================================================= -->
                <!-- CANVAS                                            -->
                <!-- ================================================= -->

                <Grid>
                    <Grid.Resources>

                        <Style TargetType="{x:Type ScrollViewer}"
                               BasedOn="{StaticResource CodeScrollViewer}"/>

                    </Grid.Resources>
                    <richCanvas:RichItemsControl
                                x:Name="LadyCanvas"
                                ItemsSource="{Binding CanvasItems}"
                                SelectedItems="{Binding SelectedItems}"
                                Background="{StaticResource CanvasBackground}"
                                behaviors:CommandBehavior.Command="{Binding SelectItemCommand}"
                                behaviors:CommandBehavior.CommandParameter="{x:Null}">

                        <richCanvas:RichItemsControl.Resources>

                            <!-- APPLICATION -->
                            <DataTemplate DataType="{x:Type canvasElements:ConsoleApplication}">

                                <Border Background="{DynamicResource ApplicationBackground}"
                                        CornerRadius="5"
                                        behaviors:CommandBehavior.Command="{Binding DataContext.SelectItemCommand}">

                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush"
                                                    Value="{DynamicResource ApplicationBorder}"/>
                                            <Setter Property="BorderThickness"
                                                    Value="2"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHighlighted}"
                                                             Value="True">

                                                    <Setter Property="BorderThickness" Value="5"/>

                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="48"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Application fejléc -->
                                        <Border Grid.Row="0"
                                                Background="{DynamicResource ApplicationHeader}"
                                                Padding="15,0"
                                                behaviors:CommandBehavior.Command="{Binding DataContext.SelectItemCommand,
                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                behaviors:CommandBehavior.CommandParameter="{Binding}">             

                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center">

                                                <TextBlock Text="▣"
                                                           Foreground="{DynamicResource ApplicationBorder}"
                                                           FontSize="18"
                                                           Margin="0,0,10,0"/>

                                                <TextBlock Text="APPLICATION"
                                                           Foreground="#1769A9"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"/>

                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="#23405B"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Margin="15,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Application tartalma -->
                                        <ItemsControl Grid.Row="1"
                                                      ItemsSource="{Binding Children}">

                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">

                                                    <Setter Property="Canvas.Left"
                                                            Value="{Binding X}"/>

                                                    <Setter Property="Canvas.Top"
                                                            Value="{Binding Y}"/>

                                                    <Setter Property="Width"
                                                            Value="{Binding Width}"/>

                                                    <Setter Property="Height"
                                                        Value="{Binding Height}"/>

                                                </Style>
                                            </ItemsControl.ItemContainerStyle>

                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                            
                            <!-- COMMAND -->
                            <DataTemplate DataType="{x:Type canvasElements:Command}">

                                <Border Background="{DynamicResource CommandBackground}"
                                        CornerRadius="5"
                                        behaviors:CommandBehavior.Command="{Binding DataContext.SelectItemCommand,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                        behaviors:CommandBehavior.CommandParameter="{Binding}">
                                    
                                    <Border.Style>
                                        <Style TargetType="Border">

                                            <Setter Property="BorderBrush"
                                                    Value="{DynamicResource CommandBorder}"/>

                                            <Setter Property="BorderThickness"
                                                    Value="2"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding IsHighlighted}"
                                                             Value="True">

                                                    <Setter Property="BorderThickness"
                                                            Value="5"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>
                                    </Border.Style>

                                    <Grid>

                                        <Grid.RowDefinitions>

                                            <RowDefinition Height="43"/>
                                            <RowDefinition Height="*"/>

                                        </Grid.RowDefinitions>

                                        <Border Background="{DynamicResource CommandHeader}"
                                                Padding="12,0">

                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center">

                                                <TextBlock Text="▤"
                                                           Foreground="{DynamicResource CommandBorder}"
                                                           Margin="0,0,8,0"/>

                                                <TextBlock Text="COMMAND"
                                                           Foreground="#087777"
                                                           FontSize="11"
                                                           FontWeight="Bold"/>

                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="#234F50"
                                                           FontWeight="SemiBold"
                                                           Margin="12,0,0,0"/>

                                            </StackPanel>

                                        </Border>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </richCanvas:RichItemsControl.Resources>


                        <!-- RICHCANVAS POZÍCIÓ / MÉRET -->

                        <richCanvas:RichItemsControl.ItemContainerStyle>

                            <Style TargetType="richCanvas:RichItemContainer">

                                <Setter Property="Top"
                                        Value="{Binding Y, Mode=TwoWay}"/>

                                <Setter Property="Left"
                                        Value="{Binding X, Mode=TwoWay}"/>

                                <Setter Property="Width"
                                        Value="{Binding Width, Mode=TwoWay}"/>

                                <Setter Property="Height"
                                        Value="{Binding Height, Mode=TwoWay}"/>

                            </Style>

                        </richCanvas:RichItemsControl.ItemContainerStyle>

                    </richCanvas:RichItemsControl>
                </Grid>

                <!-- ================================================= -->
                <!-- RESIZE BAR                                        -->
                <!-- ================================================= -->
                
                <GridSplitter
                    Grid.Row="1"
                    Height="5"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource PanelBorder}"
                    ResizeDirection="Rows"
                    ResizeBehavior="PreviousAndNext"/>

                <!-- ================================================= -->
                <!-- CODE PANEL                                        -->
                <!-- ================================================= -->

                <Border Grid.Row="2"
                        Background="{DynamicResource CodeBackground}"
                        BorderBrush="{DynamicResource PanelBorder}"
                        BorderThickness="0,1,0,0">

                    <TabControl Style="{StaticResource CodeTabControl}">

                        <!-- CODE -->
                        <TabItem Header="Code"
                                 Style="{StaticResource CodeTabItem}">

                            <TabItem.Content>
                                <Grid Background="{DynamicResource CodeBackground}">

                                    <Grid.Resources>

                                        <Style TargetType="{x:Type ScrollBar}"
                                               BasedOn="{StaticResource CodeScrollBar}"/>

                                        <Style TargetType="{x:Type ScrollViewer}"
                                               BasedOn="{StaticResource CodeScrollViewer}"/>

                                    </Grid.Resources>

                                    <avalonEdit:TextEditor
                                                x:Name="CodeEditor"
                                                Background="{DynamicResource CodeBackground}"
                                                Foreground="{DynamicResource CodeForeground}"
                                                FontFamily="Consolas"
                                                FontSize="14"
                                                ShowLineNumbers="True"
                                                HorizontalScrollBarVisibility="Auto"
                                                VerticalScrollBarVisibility="Auto"
                                                Padding="12,8"/>        

                                </Grid>
                            </TabItem.Content>

                        </TabItem>


                        <!-- CONSOLE -->
                        <TabItem Header="Console"
                                 Style="{StaticResource CodeTabItem}">

                            <TabItem.Content>
                                <Grid Background="{DynamicResource CodeBackground}">

                                    <TextBox Style="{StaticResource ConsoleTextBox}"/>

                                </Grid>
                            </TabItem.Content>

                        </TabItem>

                    </TabControl>

                </Border>

            </Grid>


            <!-- ================================================= -->
            <!-- RIGHT PROPERTIES                                  -->
            <!-- ================================================= -->

            <Border Grid.Column="2"
                    Background="{DynamicResource PropertiesBackground}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="1,0,0,0">

                <Grid>
                    <Grid.Resources>
                        <Style TargetType="{x:Type ScrollViewer}"
                               BasedOn="{StaticResource CodeScrollViewer}"/>
                    </Grid.Resources>


                    <!-- ===================================================== -->
                    <!-- NINCS KIJELÖLT ELEM                                   -->
                    <!-- ===================================================== -->

                    <StackPanel Margin="15">

                        <StackPanel.Style>
                            <Style TargetType="StackPanel">

                                <Setter Property="Visibility"
                            Value="Collapsed"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding SelectedItem}"
                                     Value="{x:Null}">

                                        <Setter Property="Visibility"
                                    Value="Visible"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>
                        </StackPanel.Style>


                        <DockPanel Margin="0,0,0,18">

                            <TextBlock Text="Properties"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                            <Button Content="x"
                                    Style="{StaticResource CompileButtonStyle}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,14,0"
                                    Command="{Binding DataContext.ShowPropertiesButtonClicked,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"/>

                        </DockPanel>


                        <TextBlock Text="No element selected"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="12"/>

                    </StackPanel>


                    <!-- ===================================================== -->
                    <!-- KIJELÖLT ELEM                                         -->
                    <!-- ===================================================== -->

                    <ContentControl Content="{Binding SelectedItem}">

                        <ContentControl.Style>

                            <Style TargetType="ContentControl">

                                <Setter Property="Visibility"
                            Value="Visible"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding SelectedItem}"
                                     Value="{x:Null}">

                                        <Setter Property="Visibility"
                                    Value="Collapsed"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </ContentControl.Style>


                        <ContentControl.Resources>


                            <!-- ================================================= -->
                            <!-- APPLICATION PROPERTIES                            -->
                            <!-- ================================================= -->

                            <DataTemplate DataType="{x:Type canvasElements:ConsoleApplication}">

                                <ScrollViewer VerticalScrollBarVisibility="Auto">

                                    <StackPanel Margin="15">


                                        <!-- ============================== -->
                                        <!-- Properties fejléc              -->
                                        <!-- ============================== -->

                                        <DockPanel Margin="0,0,0,18">

                                            <TextBlock Text="Properties"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>

                                            <Button Content="x"
                                                    Style="{StaticResource CompileButtonStyle}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,14,0"
                                                    Command="{Binding DataContext.ShowPropertiesButtonClicked,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"/>

                                        </DockPanel>


                                        <!-- ============================== -->
                                        <!-- Típus                           -->
                                        <!-- ============================== -->

                                        <TextBlock Text="Application"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="12"
                                       Margin="0,0,0,12"/>


                                        <!-- ============================== -->
                                        <!-- Name                            -->
                                        <!-- ============================== -->

                                        <TextBlock Text="Name"
                                       Foreground="{DynamicResource PropertiesSectionHeader}"
                                       FontSize="12"
                                       Margin="0,0,0,5"/>

                                        <TextBox Text="{Binding Name,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource InputBackground}"
                                     BorderBrush="{DynamicResource InputBorder}"
                                     Foreground="{DynamicResource InputForeground}"
                                     Padding="8,6"
                                     Margin="0,0,0,15"/>


                                        <!-- ============================== -->
                                        <!-- Children                        -->
                                        <!-- ============================== -->

                                        <TextBlock Text="Commands"
                                       Foreground="{DynamicResource PropertiesSectionHeader}"
                                       FontSize="12"
                                       Margin="0,0,0,8"/>


                                        <ItemsControl ItemsSource="{Binding Children}">

                                            <ItemsControl.ItemTemplate>

                                                <DataTemplate>

                                                    <Grid Margin="0,0,0,6">

                                                        <Grid.ColumnDefinitions>

                                                            <ColumnDefinition Width="*"/>

                                                            <ColumnDefinition Width="32"/>

                                                        </Grid.ColumnDefinitions>


                                                        <!-- Command neve -->
                                                        <Border Grid.Column="0"
                                                    Background="{DynamicResource InputBackground}"
                                                    BorderBrush="{DynamicResource InputBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,6">

                                                            <TextBlock Text="{Binding Name}"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           VerticalAlignment="Center"/>

                                                        </Border>


                                                        <!-- Command törlése -->
                                                        <Button Grid.Column="1"
                                                                Width="28"
                                                                Height="28"
                                                                Margin="5,0,0,0"
                                                                Content="✕"
                                                                Foreground="#E05252"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                FontSize="13"
                                                                Command="{Binding DataContext.DeleteItemCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>  

                                                    </Grid>

                                                </DataTemplate>

                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>


                                        <!-- ============================== -->
                                        <!-- Add Command                     -->
                                        <!-- ============================== -->

                                        <Button Content="Add Command"
                                                Height="32"
                                                Margin="0,10,0,0"
                                                Background="{DynamicResource Accent}"
                                                Foreground="{DynamicResource AccentForeground}"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.AddCommandToApplicationCommand,
                                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>

                                        <Button Content="DELETE"
                                                Height="32"
                                                Margin="0,15,0,0"
                                                Background="#E05252"
                                                Foreground="White"
                                                BorderThickness="0"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                ToolTip="Delete Application"
                                                Command="{Binding DataContext.DeleteItemCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>              

                                    </StackPanel>

                                </ScrollViewer>

                            </DataTemplate>


                            <!-- ================================================= -->
                            <!-- COMMAND PROPERTIES                                -->
                            <!-- ================================================= -->

                            <DataTemplate DataType="{x:Type canvasElements:Command}">

                                <ScrollViewer VerticalScrollBarVisibility="Auto">

                                    <StackPanel Margin="15">

                                        <!-- ============================== -->
                                        <!-- Properties fejléc              -->
                                        <!-- ============================== -->

                                        <DockPanel Margin="0,0,0,18">

                                            <TextBlock Text="Properties"
                                                        Foreground="{DynamicResource TextPrimary}"
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        VerticalAlignment="Center"/>

                                            <Button Content="x"
                                                     Style="{StaticResource CompileButtonStyle}"
                                                     HorizontalAlignment="Right"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,14,0"
                                                     Command="{Binding DataContext.ShowPropertiesButtonClicked,
                                                                       RelativeSource={RelativeSource AncestorType=Window}}"/>

                                        </DockPanel>


                                        <!-- ============================== -->
                                        <!-- Típus                           -->
                                        <!-- ============================== -->

                                        <TextBlock Text="Command"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="12"
                                       Margin="0,0,0,12"/>


                                        <!-- ============================== -->
                                        <!-- Name                            -->
                                        <!-- ============================== -->

                                        <TextBlock Text="Name"
                                       Foreground="{DynamicResource PropertiesSectionHeader}"
                                       FontSize="12"
                                       Margin="0,0,0,5"/>

                                        <TextBox Text="{Binding Name,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource InputBackground}"
                                     BorderBrush="{DynamicResource InputBorder}"
                                     Foreground="{DynamicResource InputForeground}"
                                     Padding="8,6"/>

                                        <Button Content="DELETE"
                                                Height="32"
                                                Margin="0,15,0,0"
                                                Background="#E05252"
                                                Foreground="White"
                                                BorderThickness="0"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                ToolTip="Delete Application"
                                                Command="{Binding DataContext.DeleteItemCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>

                                    </StackPanel>

                                </ScrollViewer>

                            </DataTemplate>


                        </ContentControl.Resources>

                    </ContentControl>

                </Grid>

            </Border>

        </Grid>

        <!-- ===================================================== -->
        <!-- STATUS BAR                                            -->
        <!-- ===================================================== -->

        <Border Grid.Row="2"
                Background="{DynamicResource StatusBarBackground}">

            <DockPanel>

                <TextBlock Text="{Binding CaretPositionText}"
                           Foreground="{DynamicResource StatusBarForeground}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Right"
                           Margin="0,0,15,0"/>

            </DockPanel>

        </Border>

    </Grid>

</Window>
