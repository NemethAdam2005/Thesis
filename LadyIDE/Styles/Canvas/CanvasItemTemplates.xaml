    <DataTemplate DataType="{x:Type canvasElements:Action}">

        <Border
        Style="{StaticResource ActionCanvasItemStyle}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="43"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ACTION HEADER -->

                <Border
                Grid.Row="0"
                Background="{DynamicResource ActionHeader}"
                Padding="12,0"
                CornerRadius="3,3,0,0"
                behaviors:CommandBehavior.Command="{Binding DataContext.SelectItemCommand,
                RelativeSource={RelativeSource AncestorType=Window}}"
                behaviors:CommandBehavior.CommandParameter="{Binding}">

                    <StackPanel
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                        <TextBlock
                        Text="⊕"
                        Foreground="{DynamicResource ActionBorder}"
                        FontSize="19"
                        FontWeight="Bold"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"/>

                        <TextBlock
                        Text="ACTION"
                        Foreground="{DynamicResource ActionHeaderText}"
                        FontSize="11"
                        FontWeight="Bold"
                        VerticalAlignment="Center"/>

                        <TextBlock
                        Text="{Binding Name}"
                        Foreground="{DynamicResource ActionNameText}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"/>

                        <!-- PIPE AND FILTER MARKER -->

                        <Border
                        Background="{DynamicResource ActionBorder}"
                        CornerRadius="4"
                        Padding="5,2"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center">

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>

                                    <Style.Triggers>
                                        <DataTrigger
                                        Binding="{Binding PipeAndFilterAction}"
                                        Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <TextBlock
                            Text="P&amp;F"
                            Foreground="White"
                            FontSize="9"
                            FontWeight="Bold"/>
                        </Border>

                    </StackPanel>

                </Border>

                <!-- ACTION CONTENT -->

                <ItemsControl
                Grid.Row="1"
                ItemsSource="{Binding Children}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">

                            <Setter
                            Property="Canvas.Left"
                            Value="{Binding X}"/>

                            <Setter
                            Property="Canvas.Top"
                            Value="{Binding Y}"/>

                            <Setter
                            Property="Width"
                            Value="{Binding Width}"/>

                            <Setter
                            Property="Height"
                            Value="{Binding Height}"/>

                        </Style>
                    </ItemsControl.ItemContainerStyle>

                </ItemsControl>

            </Grid>

        </Border>

    </DataTemplate>

