                Foreground="{DynamicResource InputForeground}"
                Padding="8,6"
                Margin="0,0,0,15"/>

                <!-- ================================================= -->
                <!-- LAZY                                              -->
                <!-- ================================================= -->

                <TextBlock
                Text="Lazy"
                Foreground="{DynamicResource PropertiesSectionHeader}"
                FontSize="12"
                Margin="0,0,0,5">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEntityField}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- LAZY CHECKBOX -->

                <CheckBox
                    Content="Is lazy?"
                    IsChecked="{Binding IsLazy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,0,0,15"
                    Command="{Binding DataContext.FieldLazyChangedCommand,
                    RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">

                    <CheckBox.Style>
                        <Style TargetType="CheckBox"
                               BasedOn="{StaticResource CheckBoxStyle}">

                            <Setter Property="Visibility"
                                    Value="Collapsed"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEntityField}"
                                             Value="True">

                                    <Setter Property="Visibility"
                                            Value="Visible"/>

                                </DataTrigger>
                            </Style.Triggers>

                        </Style>
                    </CheckBox.Style>

                </CheckBox>

                <!-- ================================================= -->
                <!-- TYPE                                              -->
                <!-- ================================================= -->

                <TextBlock
                Text="Type"
                Foreground="{DynamicResource PropertiesSectionHeader}"
                FontSize="12"
                Margin="0,0,0,5"/>


                <ComboBox
					Style="{DynamicResource PropertyComboBoxStyle}"
					ItemsSource="{Binding DataContext.InputTypes,
                                      RelativeSource={RelativeSource AncestorType=Window}}"
					SelectedItem="{Binding Type,
                                       Mode=TwoWay,
                                       UpdateSourceTrigger=PropertyChanged}"
					Height="32"
					Margin="0,0,0,15"/>
                
                <!-- ================================================= -->
                <!-- LOGIC                                             -->
                <!-- ================================================= -->

                <StackPanel Margin="0,15,0,0">

                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLazy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- LOGIC HEADER -->

                    <StackPanel Orientation="Horizontal">

                        <TextBlock
                            Text="Logic -"
                            Foreground="{DynamicResource PropertiesSectionHeader}"
                            FontSize="12"
                            Margin="0,0,4,8"/>      

                        <TextBlock
                            Text="(Only one logic allowed)"
                            Foreground="{DynamicResource PropertiesSectionHeader}"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Margin="0,0,0,8"/>

                    </StackPanel>

                    <!-- LOGIC LIST -->

                    <ItemsControl ItemsSource="{Binding Children}">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Grid Margin="0,0,0,6">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="32"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- LOGIC NAME -->

                                    <Border
                                         Grid.Column="0"
                                        Background="{DynamicResource InputBackground}"
                                        BorderBrush="{DynamicResource InputBorder}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8,6">  

                                        <TextBlock
                                            Text="Logic"
                                            Foreground="{DynamicResource TextPrimary}"
                                            VerticalAlignment="Center"/>        

                                    </Border>

                                    <!-- DELETE LOGIC -->

                                    <Button
                                        Grid.Column="1"
                                        Width="28"
                                        Height="28"
                                        Margin="5,0,0,0"
                                        Content="✕"
                                        Foreground="{DynamicResource XDeleteButtonForeground}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="13"
                                        Command="{Binding DataContext.DeleteItemCommand,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>      

                                </Grid>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                    <!-- ADD LOGIC -->

                    <Button
                        Style="{DynamicResource AddButtonStyle}"
                        Content="Add Logic"
                        IsEnabled="True"
                        Command="{Binding DataContext.AddLogicToFieldCommand,
                            RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        Margin="0,6,0,18"/>

                </StackPanel>

                <!-- ================================================= -->
                <!-- DELETE FIELD                                      -->
                <!-- ================================================= -->

                <Button
                Style="{DynamicResource DeleteButtonStyle}"
                Content="DELETE"
                Command="{Binding DataContext.DeleteItemCommand,
                RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}"/>

            </StackPanel>

        </ScrollViewer>

    </DataTemplate>

