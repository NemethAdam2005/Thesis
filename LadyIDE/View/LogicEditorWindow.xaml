<Window
    x:Class="LadyIDE.WPF.View.LogicEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
    Title="Logic Editor"
    Width="1000"
    Height="700"
    MinWidth="650"
    MinHeight="450"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource AppBackground}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock
                    Text="Logic Editor"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimary}"/>

                <TextBlock
                    Text="Edit the logic associated with this element."
                    Margin="0,5,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource InputForeground}"/>
            </StackPanel>

            <Border
                Grid.Column="1"
                Padding="10,5"
                CornerRadius="5"
                VerticalAlignment="Center"
                Background="{DynamicResource InputBackground}"
                BorderBrush="{DynamicResource InputBorder}"
                BorderThickness="1">

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <TextBlock
                    Text="Modified"
                    Foreground="{DynamicResource TextPrimary}"
                    FontSize="12"/>
            </Border>
        </Grid>

        <!-- Editor -->
        <Border
            Grid.Row="1"
            Background="{DynamicResource InputBackground}"
            BorderBrush="{DynamicResource InputBorder}"
            BorderThickness="1"
            CornerRadius="5"
            ClipToBounds="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Grid.Resources>

                    <Style TargetType="{x:Type ScrollViewer}"
                            BasedOn="{StaticResource CodeScrollViewer}"/>

                </Grid.Resources>

                <!-- Toolbar -->
                <Border
                    Grid.Row="0"
                    Background="{DynamicResource MenuBackground}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="0,0,0,1"
                    Padding="8,8,0,0">

                    <WrapPanel>
                        <Button Content="()"
                                Command="{Binding InsertTokenCommand}"
                                CommandParameter="()"
                                Style="{DynamicResource AddButtonStyle}"
                                MinWidth="48"
                                Margin="0,0,8,8"/>

                        <Button Content="AND"
                                Command="{Binding InsertTokenCommand}"
                                CommandParameter="AND"
                                Style="{DynamicResource AddButtonStyle}"
                                MinWidth="55"
                                Margin="0,0,8,8"/>

                        <Button Content="OR"
                                Command="{Binding InsertTokenCommand}"
                                CommandParameter="OR"
                                Style="{DynamicResource AddButtonStyle}"
                                MinWidth="48"
                                Margin="0,0,8,8"/>

                        <Button Content="map"
                                Command="{Binding InsertTokenCommand}"
                                CommandParameter="map"
                                Style="{DynamicResource AddButtonStyle}"
                                MinWidth="55"
                                Margin="0,0,8,8"/>

                        <Button Content="flatten"
                                Command="{Binding InsertTokenCommand}"
                                CommandParameter="flatten"
                                Style="{DynamicResource AddButtonStyle}"
                                MinWidth="65"
                                Margin="0,0,8,8"/>

                        <Button Content="forall"
                                Command="{Binding InsertTokenCommand}"
                                CommandParameter="forall"
                                Style="{DynamicResource AddButtonStyle}"
                                MinWidth="60"
                                Margin="0,0,8,8"/>

                        <Button Content="=="
                                Command="{Binding InsertTokenCommand}"
                                CommandParameter="=="
                                Style="{DynamicResource AddButtonStyle}"
                                MinWidth="48"
                                Margin="0,0,8,8"/>

                        <Button Content="!="
                                Command="{Binding InsertTokenCommand}"
                                CommandParameter="!="
                                Style="{DynamicResource AddButtonStyle}"
                                MinWidth="48"
                                Margin="0,0,8,8"/>

                        <Button Content=":="
                                Command="{Binding InsertTokenCommand}"
                                CommandParameter=":="
                                Style="{DynamicResource AddButtonStyle}"
                                MinWidth="48"
                                Margin="0,0,8,8"/>

                        <Button Content="code"
                                Command="{Binding InsertCodeCommand}"
                                Style="{DynamicResource AddButtonStyle}"
                                MinWidth="55"
                                Margin="0,0,8,8"/>

                        <Button Content="create"
                                Command="{Binding InsertTokenCommand}"
                                CommandParameter="create"
                                Style="{DynamicResource AddButtonStyle}"
                                MinWidth="60"
                                Margin="0,0,8,8"/>

                        <Button Content="!"
                                Command="{Binding InsertTokenCommand}"
                                CommandParameter="!"
                                Style="{DynamicResource AddButtonStyle}"
                                MinWidth="40"
                                Margin="0,0,8,8"/>

                        <Button Content="EMPTY"
                                Command="{Binding InsertTokenCommand}"
                                CommandParameter="EMPTY"
                                Style="{DynamicResource AddButtonStyle}"
                                MinWidth="65"
                                Margin="0,0,8,8"/>
                    </WrapPanel>
                </Border>

                <!-- AvalonEdit -->
                <avalonedit:TextEditor
                    x:Name="LogicTextEditor"
                    Grid.Row="1"
                    ShowLineNumbers="True"
                    FontFamily="Consolas"
                    FontSize="14"
                    Padding="8"
                    Foreground="{DynamicResource InputForeground}"
                    Background="{DynamicResource InputBackground}"
                    BorderThickness="0"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    WordWrap="False"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                    Text="{Binding CaretPositionText}"
                    Foreground="{DynamicResource InputForeground}"
                    FontSize="12"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"/>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right">

                <Button
                    Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Style="{DynamicResource DeleteButtonStyle}"
                    MinWidth="100"
                    Padding="12,7"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"/>

                <Button
                    Content="Save"
                    Command="{Binding SaveCommand}"
                    Style="{DynamicResource AddButtonStyle}"
                    IsDefault="True"
                    MinWidth="100"
                    Padding="12,7"
                    VerticalAlignment="Center"
                    Margin="0"/>
                
            </StackPanel>
        </Grid>
    </Grid>
</Window>
