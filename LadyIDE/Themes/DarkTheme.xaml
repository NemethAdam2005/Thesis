<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================= -->
    <!-- GENERAL                                          -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="AppBackground"
                     Color="#111A24"/>

    <SolidColorBrush x:Key="PanelBackground"
                     Color="#172331"/>

    <SolidColorBrush x:Key="PanelBackgroundSecondary"
                     Color="#1D2A38"/>

    <SolidColorBrush x:Key="PanelBorder"
                     Color="#2D3B4B"/>


    <!-- ================================================= -->
    <!-- TEXT                                              -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="TextPrimary"
                     Color="#EAF2FA"/>

    <SolidColorBrush x:Key="TextSecondary"
                     Color="#8D9AAA"/>

    <SolidColorBrush x:Key="TextDisabled"
                     Color="#596777"/>


    <!-- ================================================= -->
    <!-- INPUT                                             -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="InputBackground"
                     Color="#243243"/>

    <SolidColorBrush x:Key="InputBorder"
                     Color="#394B5D"/>

    <SolidColorBrush x:Key="InputForeground"
                     Color="#EAF2FA"/>


    <!-- ================================================= -->
    <!-- MENU                                              -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="MenuBackground"
                     Color="#111A24"/>

    <SolidColorBrush x:Key="MenuHoverBackground"
                     Color="#263646"/>

    <SolidColorBrush x:Key="MenuBorder"
                     Color="#2D3B4B"/>


    <!-- ================================================= -->
    <!-- PALETTE                                           -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="PaletteBackground"
                     Color="#172331"/>

    <SolidColorBrush x:Key="PaletteButtonBackground"
                     Color="#172331"/>

    <SolidColorBrush x:Key="PaletteButtonHoverBackground"
                     Color="#2B3C4F"/>

    <SolidColorBrush x:Key="PaletteButtonBorder"
                     Color="#2D3B4B"/>


    <!-- ================================================= -->
    <!-- CODE                                              -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="CodeBackground"
                     Color="#101820"/>

    <SolidColorBrush x:Key="CodeForeground"
                     Color="#EAF2FA"/>

    <SolidColorBrush x:Key="CodeBorder"
                     Color="#2D3B4B"/>


    <!-- ================================================= -->
    <!-- TABS                                              -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="TabBackground"
                     Color="#172331"/>

    <SolidColorBrush x:Key="TabSelectedBackground"
                     Color="#263F57"/>

    <SolidColorBrush x:Key="TabBorder"
                     Color="#1688E8"/>


    <!-- ================================================= -->
    <!-- CANVAS                                            -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="CanvasBackground"
                     Color="#F7F9FC"/>

    <SolidColorBrush x:Key="CanvasGridDot"
                     Color="#DCE3EB"/>


    <!-- ================================================= -->
    <!-- STATUS BAR                                        -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="StatusBarBackground"
                     Color="#0D151D"/>

    <SolidColorBrush x:Key="StatusBarForeground"
                     Color="#8D9AAA"/>


    <!-- ================================================= -->
    <!-- ACCENT                                            -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="Accent"
                     Color="#1688E8"/>

    <SolidColorBrush x:Key="AccentHover"
                     Color="#2B9AF0"/>

    <SolidColorBrush x:Key="AccentForeground"
                     Color="#FFFFFF"/>


    <!-- ================================================= -->
    <!-- PROPERTIES                                        -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="PropertiesBackground"
                     Color="#172331"/>

    <SolidColorBrush x:Key="PropertiesSectionHeader"
                     Color="#AEBAC8"/>


    <!-- ================================================= -->
    <!-- SCROLLBAR                                         -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="ScrollBarThumb"
                     Color="#526477"/>

    <SolidColorBrush x:Key="ScrollBarThumbHover"
                     Color="#71869A"/>

    <SolidColorBrush x:Key="CodeScrollBarButtonBackground"
                     Color="#252525"/>

    <SolidColorBrush x:Key="CodeScrollBarHoverBackground"
                     Color="#303030"/>


    <!-- ================================================= -->
    <!-- DELETE BUTTON                                     -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="DeleteButtonBackground"
                     Color="#E05252"/>

    <SolidColorBrush x:Key="DeleteButtonForeground"
                     Color="#FFFFFF"/>


    <!-- ================================================= -->
    <!-- APPLICATION                                       -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="ApplicationBorder"
                     Color="#1688E8"/>

    <SolidColorBrush x:Key="ApplicationHeader"
                     Color="#D7EBFF"/>

    <SolidColorBrush x:Key="ApplicationBackground"
                     Color="#EFF7FF"/>

    <SolidColorBrush x:Key="ApplicationHeaderText"
                     Color="#1769A9"/>

    <SolidColorBrush x:Key="ApplicationNameText"
                     Color="#23405B"/>


    <!-- ================================================= -->
    <!-- COMMAND                                           -->
    <!-- ================================================= -->

    <SolidColorBrush x:Key="CommandBorder"
