    <!-- ========================================================= -->
    <!-- COMPOSITE TYPE PROPERTIES                                 -->
    <!-- ========================================================= -->

    <DataTemplate DataType="{x:Type canvasElements:CompositeTypeElement}">

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="15">

                <!-- PROPERTIES HEADER -->

                <DockPanel Margin="0,0,0,18">

                    <TextBlock
                    Text="Properties"
                    Foreground="{DynamicResource TextPrimary}"
                    FontSize="14"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

                    <Button
                    Content="x"
                    Style="{StaticResource ClosePropertiesButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,14,0"
                    Command="{Binding DataContext.ShowPropertiesButtonClicked,
                                      RelativeSource={RelativeSource AncestorType=Window}}"/>

                </DockPanel>

                <!-- TYPE -->

                <StackPanel
                Orientation="Horizontal"
                Margin="0,0,0,15">

                    <Border
                    Width="27"
                    Height="27"
                    Background="{DynamicResource CompositeTypeBorder}"
                    CornerRadius="4"
                    Margin="0,0,10,0">

                        <TextBlock
                        Text="▰"
                        Foreground="White"
                        FontSize="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                    </Border>

                    <TextBlock
                    Text="Composite Type"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextPrimary}"
                    FontSize="12"/>

                </StackPanel>

                <!-- COMPOSITE TYPE -->

                <TextBlock
                Text="Relationship type"
                Foreground="{DynamicResource PropertiesSectionHeader}"
                FontSize="12"
                Margin="0,0,0,5"/>

                <ComboBox
                Style="{DynamicResource PropertyComboBoxStyle}"
                ItemsSource="{Binding DataContext.CompositeTypes,
                                      RelativeSource={RelativeSource AncestorType=Window}}"
                SelectedItem="{Binding Parent.CompositeType,
                                       Mode=TwoWay,
                                       UpdateSourceTrigger=PropertyChanged}"
                Height="32"
                Margin="0,0,0,15"/>

            </StackPanel>

        </ScrollViewer>

    </DataTemplate>


    <!-- ========================================================= -->
    <!-- ACTION PROPERTIES                                         -->
    <!-- ========================================================= -->

    <DataTemplate DataType="{x:Type canvasElements:Action}">

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="15">

                <!-- PROPERTIES HEADER -->

                <DockPanel Margin="0,0,0,18">

                    <Button
                    Content="x"
                    DockPanel.Dock="Right"
                    Style="{StaticResource ClosePropertiesButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,14,0"
                    Command="{Binding DataContext.ShowPropertiesButtonClicked,
                        RelativeSource={RelativeSource AncestorType=Window}}"/>

                    <TextBlock
                    Text="Properties"
                    Foreground="{DynamicResource TextPrimary}"
                    FontSize="14"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

                </DockPanel>

                <!-- ELEMENT TYPE -->

                <StackPanel
                Orientation="Horizontal"
                Margin="0,0,0,15">

                    <Border
                    Width="27"
                    Height="27"
                    Background="{DynamicResource ActionBorder}"
                    CornerRadius="4"
                    Margin="0,0,10,0">

                        <TextBlock
                        Text="⊕"
                        Foreground="White"
                        FontSize="15"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                    </Border>

                    <TextBlock
                    Text="Action"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextPrimary}"
                    FontSize="12"/>

                </StackPanel>

                <!-- NAME -->

                <TextBlock
                Text="Name"
                Foreground="{DynamicResource PropertiesSectionHeader}"
                FontSize="12"
                Margin="0,0,0,5"/>

                <TextBox
                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                Background="{DynamicResource InputBackground}"
                BorderBrush="{DynamicResource InputBorder}"
                Foreground="{DynamicResource InputForeground}"
                Padding="8,6"
                Margin="0,0,0,15"/>

                <!-- PIPE AND FILTER -->

                <CheckBox
                Content="Pipe and Filter Action"
                IsChecked="{Binding PipeAndFilterAction, Mode=TwoWay}"
                Foreground="{DynamicResource TextPrimary}"
                Margin="0,0,0,20"/>

                <!-- INPUT SECTION -->

                <StackPanel Margin="0,0,0,18">

                    <TextBlock
                    Text="Input — only one allowed"
                    Foreground="{DynamicResource PropertiesSectionHeader}"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Margin="0,0,0,8"/>

                    <ContentControl Content="{Binding InputElement}">
                        <ContentControl.Style>
                            <Style TargetType="{x:Type ContentControl}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InputElement}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>

                        <ContentControl.ContentTemplate>
                            <DataTemplate>

                                <Grid Margin="0,0,0,8">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="32"/>
                                    </Grid.ColumnDefinitions>

                                    <Border
                                    Grid.Column="0"
                                    Background="{DynamicResource InputBackground}"
                                    BorderBrush="{DynamicResource InputBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,6">

                                        <TextBlock
                                        Text="Input"
                                        Foreground="{DynamicResource TextPrimary}"
                                        VerticalAlignment="Center"/>

                                    </Border>

                                    <Button
                                    Grid.Column="1"
                                    Width="28"
                                    Height="28"
                                    Margin="5,0,0,0"
                                    Content="✕"
                                    Foreground="{DynamicResource XDeleteButtonForeground}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding DataContext.DeleteItemCommand,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>

                                </Grid>

                            </DataTemplate>
                        </ContentControl.ContentTemplate>

                    </ContentControl>

                    <Button
                    Style="{DynamicResource AddButtonStyle}"
                    Content="Add Input"
                    Command="{Binding DataContext.AddInputToActionCommand,
                        RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"/>

                </StackPanel>

                <!-- OUTPUT SECTION -->

                <StackPanel Margin="0,0,0,18">

                    <TextBlock
                    Text="Output — only one allowed"
                    Foreground="{DynamicResource PropertiesSectionHeader}"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Margin="0,0,0,8"/>

                    <ContentControl Content="{Binding OutputElement}">

                        <ContentControl.Style>
                            <Style TargetType="{x:Type ContentControl}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OutputElement}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                        
                        <ContentControl.ContentTemplate>
                            <DataTemplate>

                                <Grid Margin="0,0,0,8">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="32"/>
                                    </Grid.ColumnDefinitions>

                                    <Border
                                    Grid.Column="0"
                                    Background="{DynamicResource InputBackground}"
                                    BorderBrush="{DynamicResource InputBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,6">

                                        <TextBlock
                                        Text="Output"
                                        Foreground="{DynamicResource TextPrimary}"
                                        VerticalAlignment="Center"/>

                                    </Border>

                                    <Button
                                    Grid.Column="1"
                                    Width="28"
                                    Height="28"
                                    Margin="5,0,0,0"
                                    Content="✕"
                                    Foreground="{DynamicResource XDeleteButtonForeground}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding DataContext.DeleteItemCommand,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>

                                </Grid>

                            </DataTemplate>
                        </ContentControl.ContentTemplate>

                    </ContentControl>

                    <Button
                    Style="{DynamicResource AddButtonStyle}"
                    Content="Add Output"
                    Command="{Binding DataContext.AddOutputToActionCommand,
                        RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"/>

                </StackPanel>

                <!-- LOGIC SECTION -->

                <StackPanel Margin="0,0,0,20">

                    <TextBlock
                    Text="Logic — only one allowed"
                    Foreground="{DynamicResource PropertiesSectionHeader}"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Margin="0,0,0,8"/>

                    <ContentControl Content="{Binding LogicElement}">

                        <ContentControl.Style>
                            <Style TargetType="{x:Type ContentControl}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LogicElement}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                        
                        <ContentControl.ContentTemplate>
                            <DataTemplate>

                                <Grid Margin="0,0,0,8">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="32"/>
                                    </Grid.ColumnDefinitions>

                                    <Border
                                    Grid.Column="0"
                                    Background="{DynamicResource InputBackground}"
                                    BorderBrush="{DynamicResource InputBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,6">

                                        <TextBlock
                                        Text="Logic"
                                        Foreground="{DynamicResource TextPrimary}"
                                        VerticalAlignment="Center"/>

                                    </Border>

                                    <Button
                                    Grid.Column="1"
                                    Width="28"
                                    Height="28"
                                    Margin="5,0,0,0"
                                    Content="✕"
                                    Foreground="{DynamicResource XDeleteButtonForeground}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding DataContext.DeleteItemCommand,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>

                                </Grid>

                            </DataTemplate>
                        </ContentControl.ContentTemplate>

                    </ContentControl>

                    <Button
                    Style="{DynamicResource AddButtonStyle}"
                    Content="Add Logic"
                    Command="{Binding DataContext.AddLogicToActionCommand,
                        RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"/>

                </StackPanel>

                <!-- DELETE ACTION -->

                <Button
                Style="{DynamicResource DeleteButtonStyle}"
                Content="DELETE"
                Command="{Binding DataContext.DeleteItemCommand,
                    RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}"/>

            </StackPanel>

        </ScrollViewer>

    </DataTemplate>

    <!-- ========================================================= -->
    <!-- OUTPUT PROPERTIES                                         -->
    <!-- ========================================================= -->

    <DataTemplate DataType="{x:Type canvasElements:Output}">

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="15">

                <!-- ================================================= -->
                <!-- PROPERTIES HEADER                                 -->
                <!-- ================================================= -->

                <DockPanel Margin="0,0,0,18">

                    <TextBlock
                    Text="Properties"
                    Foreground="{DynamicResource TextPrimary}"
                    FontSize="14"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

                    <Button
                    Content="x"
                    Style="{StaticResource ClosePropertiesButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,14,0"
                    Command="{Binding DataContext.ShowPropertiesButtonClicked,
                                      RelativeSource={RelativeSource AncestorType=Window}}"/>

                </DockPanel>

                <!-- ================================================= -->
                <!-- TYPE                                              -->
                <!-- ================================================= -->

                <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,15">

                    <Border
                    Width="27"
                    Height="27"
                    Background="{DynamicResource OutputElementBorder}"
                    CornerRadius="4"
                    Margin="0,0,10,0">

                        <TextBlock
                        Text="↗"
                        Foreground="White"
                        FontSize="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                    </Border>

                    <TextBlock
                    Text="Output"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource TextPrimary}"
                    FontSize="12"/>

                </StackPanel>

                <!-- ================================================= -->
                <!-- PARAMETERS                                        -->
                <!-- ================================================= -->

                <TextBlock
                Text="Parameters"
                Foreground="{DynamicResource PropertiesSectionHeader}"
                FontSize="12"
                Margin="0,0,0,8"/>

                <ItemsControl ItemsSource="{Binding Children}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate DataType="{x:Type canvasElements:Parameter}">

                            <Grid Margin="0,0,0,6">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>

                                <!-- Parameter name -->

                                <Border
                                Grid.Column="0"
                                Background="{DynamicResource InputBackground}"
                                BorderBrush="{DynamicResource InputBorder}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,6">

                                    <TextBlock
                                    Text="{Binding Name}"
                                    Foreground="{DynamicResource TextPrimary}"
                                    VerticalAlignment="Center"/>

                                </Border>

                                <!-- Delete parameter -->

                                <Button
                                Grid.Column="1"
                                Width="28"
                                Height="28"
                                Margin="5,0,0,0"
                                Content="✕"
                                Foreground="{DynamicResource XDeleteButtonForeground}"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                Command="{Binding DataContext.DeleteItemCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>

                            </Grid>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

                <!-- ================================================= -->
                <!-- ADD PARAMETER                                     -->
                <!-- ================================================= -->

                <Button
                Style="{DynamicResource AddButtonStyle}"
                Content="Add Parameter"
                Command="{Binding DataContext.AddParameterToOutputCommand,
                                  RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}"/>

                <!-- ================================================= -->
                <!-- DELETE OUTPUT                                     -->
                <!-- ================================================= -->

                <Button
                Style="{DynamicResource DeleteButtonStyle}"
                Content="DELETE"
                Command="{Binding DataContext.DeleteItemCommand,
                                  RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}"/>

            </StackPanel>

        </ScrollViewer>

    </DataTemplate>

    <!-- ========================================================= -->
    <!-- ACTION REFERENCE PROPERTIES                               -->
    <!-- ========================================================= -->

    <DataTemplate DataType="{x:Type canvasElements:ActionReference}">

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="15">

                <!-- PROPERTIES HEADER -->

                <DockPanel Margin="0,0,0,18">

                    <TextBlock
                        Text="Properties"
                        Foreground="{DynamicResource TextPrimary}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"/>

                    <Button
                        Content="x"
                        Style="{StaticResource ClosePropertiesButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,14,0"
                        Command="{Binding DataContext.ShowPropertiesButtonClicked,
                            RelativeSource={RelativeSource AncestorType=Window}}"/>

                </DockPanel>

                <!-- TYPE -->

                <StackPanel
                    Orientation="Horizontal"
                    Margin="0,0,0,15">

                    <Border
                        Width="27"
                        Height="27"
                        Background="{DynamicResource ActionReferenceBorder}"
                        CornerRadius="4"
                        Margin="0,0,10,0">

                        <TextBlock
                            Text="↗"
                            Foreground="White"
                            FontSize="15"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    </Border>

                    <TextBlock
                        Text="Action Reference"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextPrimary}"
                        FontSize="12"/>

                </StackPanel>

                <!-- REFERENCED ACTION -->

                <TextBlock
                    Text="Referenced Action"
                    Foreground="{DynamicResource PropertiesSectionHeader}"
                    FontSize="12"
                    Margin="0,0,0,5"/>

                <Border
                    Background="{DynamicResource InputBackground}"
                    BorderBrush="{DynamicResource InputBorder}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8,6"
                    Margin="0,0,0,15">

                    <TextBlock
                        Text="{Binding Name}"
                        Foreground="{DynamicResource TextPrimary}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"/>

                </Border>

                <!-- DELETE -->

                <Button
                    Style="{DynamicResource DeleteButtonStyle}"
                    Content="DELETE"
                    ToolTip="Delete Action Reference"
                    Command="{Binding DataContext.DeleteItemCommand,
                        RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"/>

            </StackPanel>

        </ScrollViewer>

    </DataTemplate>

</ResourceDictionary>