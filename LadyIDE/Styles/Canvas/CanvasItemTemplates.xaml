<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:LadyIDE.WPF.Behaviors"
    xmlns:canvasElements="clr-namespace:LadyIDE.WPF.CanvasElements">

    <!-- ========================================================= -->
    <!-- APPLICATION TEMPLATE                                      -->
    <!-- ========================================================= -->

    <DataTemplate DataType="{x:Type canvasElements:ConsoleApplication}">

        <Border
            Style="{StaticResource ApplicationCanvasItemStyle}"
            behaviors:CommandBehavior.Command="{Binding DataContext.SelectItemCommand}">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="48"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- APPLICATION HEADER                                -->
                <!-- ================================================= -->

                <Border
                    Grid.Row="0"
                    Background="{DynamicResource ApplicationHeader}"
                    Padding="15,0"
                    behaviors:CommandBehavior.Command="{Binding DataContext.SelectItemCommand,
                    RelativeSource={RelativeSource AncestorType=Window}}"
                    behaviors:CommandBehavior.CommandParameter="{Binding}">

                    <StackPanel
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="▣"
                            Foreground="{DynamicResource ApplicationBorder}"
                            FontSize="15"
                            Margin="0,0,10,0"/>

                        <TextBlock
                            Text="APPLICATION"
                            Foreground="{DynamicResource ApplicationHeaderText}"
                            FontWeight="Bold"
                            FontSize="11"
                            VerticalAlignment="Center"/>

                        <TextBlock
                            Text="{Binding Name}"
                            Foreground="{DynamicResource ApplicationNameText}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Margin="15,0,0,0"
                            VerticalAlignment="Center"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- APPLICATION CONTENT                               -->
                <!-- ================================================= -->

                <ItemsControl
                    Grid.Row="1"
                    ItemsSource="{Binding Children}">

                    <ItemsControl.ItemsPanel>

                        <ItemsPanelTemplate>

                            <Canvas/>

                        </ItemsPanelTemplate>

                    </ItemsControl.ItemsPanel>


                    <ItemsControl.ItemContainerStyle>

                        <Style TargetType="ContentPresenter">

                            <Setter
                                Property="Canvas.Left"
                                Value="{Binding X}"/>

                            <Setter
                                Property="Canvas.Top"
                                Value="{Binding Y}"/>

                            <Setter
                                Property="Width"
                                Value="{Binding Width}"/>

                            <Setter
                                Property="Height"
                                Value="{Binding Height}"/>

                        </Style>

                    </ItemsControl.ItemContainerStyle>

                </ItemsControl>

            </Grid>

        </Border>

    </DataTemplate>


    <!-- ========================================================= -->
    <!-- COMMAND TEMPLATE                                          -->
    <!-- ========================================================= -->

    <DataTemplate DataType="{x:Type canvasElements:Command}">

        <Border
            Style="{StaticResource CommandCanvasItemStyle}"
            behaviors:CommandBehavior.Command="{Binding DataContext.SelectItemCommand}">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="43"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- COMMAND HEADER                                    -->
                <!-- ================================================= -->

                <Border Grid.Row="0"
                        Background="{DynamicResource CommandHeader}"
                        Padding="12,0"
                        behaviors:CommandBehavior.Command="{Binding DataContext.SelectItemCommand,
                            RelativeSource={RelativeSource AncestorType=Window}}"
                        behaviors:CommandBehavior.CommandParameter="{Binding}">

                    <StackPanel
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="▤"
                            Foreground="{DynamicResource CommandBorder}"
                            FontSize="15"
                            Margin="0,0,8,0"/>

                        <TextBlock
                            Text="COMMAND"
                            Foreground="{DynamicResource CommandHeaderText}"
                            FontSize="11"
                            FontWeight="Bold"/>

                        <TextBlock
                            Text="{Binding Name}"
                            Foreground="{DynamicResource CommandNameText}"
                            FontWeight="SemiBold"
                            FontSize="13"
                            Margin="12,0,0,0"/>

                    </StackPanel>

                </Border>
                
                <!-- ================================================= -->
                <!-- COMMAND CONTENT                                   -->
                <!-- ================================================= -->
                
                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding Children}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left"
                                    Value="{Binding X}"/>
                            <Setter Property="Canvas.Top"
                                    Value="{Binding Y}"/>
                            <Setter Property="Width"
                                    Value="{Binding Width}"/>
                            <Setter Property="Height"
                                    Value="{Binding Height}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>

                </ItemsControl>

            </Grid>

        </Border>

    </DataTemplate>

